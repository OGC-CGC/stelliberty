<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SBproxy.Desktop.Controls"
             xmlns:loc="using:SBproxy.Desktop.Localization"
             xmlns:vm="using:SBproxy.Presentation.ViewModels"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             x:Class="SBproxy.Desktop.Views.ProxyView"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel"
             controls:InputDefocusBehavior.IsEnabled="True"
             Background="Transparent">
  <Grid x:Name="ProxyPageRoot"
        RowDefinitions="Auto,*" RowSpacing="16"
        DataContext="{Binding ProxyPage}"
        x:DataType="vm:ProxyPageViewModel">

    <Grid x:Name="ProxyToolbarHost"
          Margin="8,0,25,0"
          IsVisible="{Binding HasGroups}"
          ZIndex="10">
      <Border x:Name="ProxyToolbarSurface"
              Classes="surface-header"
              VerticalAlignment="Top"
              PointerEntered="OnSelectorRegionPointerEntered"
              PointerExited="OnSelectorRegionPointerExited"
              AutomationProperties.AutomationId="Proxy.Toolbar">
      <StackPanel Spacing="13">

        <Grid x:Name="SelectorDropdownAnchor"
              GotFocus="OnSelectorRegionGotFocus"
              LostFocus="OnSelectorRegionLostFocus">
          <Border AutomationProperties.AutomationId="Proxy.SelectorDropdown.Current">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <Button x:Name="SelectorDropdownArrow"
                      Grid.Column="1"
                      Classes="selector-dropdown-arrow"
                      Opacity="0"
                      IsHitTestVisible="False"
                      IsTabStop="False"
                      PointerEntered="OnSelectorArrowPointerEntered"
                      GotFocus="OnSelectorArrowGotFocus"
                      Click="OnSelectorArrowClick"
                      AutomationProperties.AutomationId="Proxy.SelectorDropdown.Arrow">
                <iconPacks:PackIconMingCuteIcons Width="16"
                                                  Height="16"
                                                  Kind="DownSmallLine"
                                                  Foreground="{DynamicResource AppTextSecondaryBrush}" />
              </Button>

              <ItemsControl x:Name="SelectorGroupItems"
                            Height="34"
                            ClipToBounds="True"
                            AutomationProperties.AutomationId="Proxy.GroupBar"
                            ItemsSource="{Binding VisibleGroupRows}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"
                               ItemSpacing="26"
                               LineSpacing="8" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProxyGroupButtonViewModel">
                    <Button Classes="proxy-group-tab"
                            Classes.selected="{Binding IsSelected}"
                            Content="{Binding Name}"
                            AutomationProperties.AutomationId="{Binding AutomationId}"
                            Command="{Binding #ProxyPageRoot.((vm:ProxyPageViewModel)DataContext).SelectGroupCommand}"
                            CommandParameter="{Binding Name}"
                            Click="OnSelectorItemClick" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </Border>

        </Grid>

        <Border Height="1" Background="{DynamicResource AppBorderBrush}" />

        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Classes="toolbar-icon"
                    AutomationProperties.AutomationId="Proxy.TestGroupDelaysButton"
                    Command="{Binding TestCurrentGroupDelaysCommand}"
                    IsEnabled="{Binding !IsBatchDelayTesting}"
                    ToolTip.Tip="{loc:Loc Proxy.Tooltip.TestCurrentGroup}">
              <iconPacks:PackIconMingCuteIcons Classes="icon" Width="15" Height="15" Kind="ChartBarFill" />
            </Button>
            <Button Classes="toolbar-icon"
                    AutomationProperties.AutomationId="Proxy.LocateButton"
                    Command="{Binding LocateSelectedNodeCommand}"
                    ToolTip.Tip="{loc:Loc Proxy.Tooltip.LocateCurrent}">
              <iconPacks:PackIconMingCuteIcons Classes="icon" Width="15" Height="15" Kind="AimingFill" />
            </Button>
            <Button Classes="toolbar-icon"
                    AutomationProperties.AutomationId="Proxy.ScrollTopButton"
                    Command="{Binding ScrollToTopCommand}"
                    ToolTip.Tip="{loc:Loc Proxy.Tooltip.ScrollTop}">
              <iconPacks:PackIconMingCuteIcons Classes="icon" Width="15" Height="15" Kind="ArrowUpLine" />
            </Button>
            <Button Classes="toolbar-icon"
                    Classes.sort-active="{Binding IsSortActive}"
                    AutomationProperties.AutomationId="Proxy.SortModeButton"
                    Command="{Binding CycleSortModeCommand}"
                    ToolTip.Tip="{Binding SortModeTooltip}">
              <iconPacks:PackIconMingCuteIcons Classes="icon" Width="15" Height="15" Kind="{Binding SortModeIcon}" />
            </Button>
          </StackPanel>

          <TextBox Grid.Column="2"
                   Classes="list-search"
                   AutomationProperties.AutomationId="Proxy.SearchBox"
                   PlaceholderText="{loc:Loc Proxy.Search.Placeholder}"
                   Text="{Binding SearchKeyword, Mode=TwoWay}"
                   MinWidth="240" MaxWidth="320">
            <TextBox.InnerLeftContent>
              <Border Padding="10,0,4,0">
                <iconPacks:PackIconMingCuteIcons Width="14" Height="14"
                                                   Kind="SearchLine"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
              </Border>
            </TextBox.InnerLeftContent>
          </TextBox>
        </Grid>
      </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="1">
      <Border Classes="list-empty"
              IsVisible="{Binding IsEmptyVisible}">
        <StackPanel Spacing="18" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Panel HorizontalAlignment="Center">
            <Border Classes="list-empty-halo" />
            <iconPacks:PackIconMingCuteIcons Classes="list-empty-icon" Kind="{Binding EmptyIconType}" />
          </Panel>
          <StackPanel Spacing="7">
            <TextBlock Classes="list-empty-text"
                       AutomationProperties.AutomationId="Proxy.EmptyText"
                       Text="{Binding EmptyText}" />
            <TextBlock Classes="list-empty-hint"
                       IsVisible="{Binding EmptySubtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Text="{Binding EmptySubtitle}" />
            <TextBlock Classes="list-empty-hint"
                       IsVisible="{Binding EmptySubtitle, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                       Text="{loc:Loc Proxy.Empty.Hint}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <ScrollViewer x:Name="NodeListScroll"
                    AutomationProperties.AutomationId="Proxy.NodeListScroll"
                    IsVisible="{Binding !IsEmptyVisible}"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="NodeList"
                      AutomationProperties.AutomationId="Proxy.NodeList"
                      Margin="8,0,25,15"
                      ItemsSource="{Binding VisibleNodeRows}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <controls:VirtualizingWrapPanel MinItemWidth="200" ItemHeight="76"
                                              ColumnSpacing="8" RowSpacing="8" EdgePadding="0" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ProxyNodeRowViewModel">
              <Border Classes="surface-card node"
                      Classes.selected="{Binding IsSelected}"
                      Tag="{Binding Name}">
                <Grid>
                  <Button Classes="card-hit-area"
                          Cursor="Arrow"
                          AutomationProperties.AutomationId="{Binding RowAutomationId}"
                          Command="{Binding #ProxyPageRoot.((vm:ProxyPageViewModel)DataContext).SelectNodeCommand}"
                          CommandParameter="{Binding Name}"
                          IsEnabled="{Binding IsClickable}" />
                  <Grid Margin="13,10" RowDefinitions="*,Auto" IsHitTestVisible="False">
                    <TextBlock Text="{Binding Name}"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Margin="0,0,28,0"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <Border Grid.Row="1"
                            Classes="list-pill"
                            Tag="neutral"
                            HorizontalAlignment="Left"
                            Margin="0,5,64,0">
                      <TextBlock Text="{Binding Type}" TextTrimming="CharacterEllipsis" />
                    </Border>
                  </Grid>
                  <Button Classes="delay-test-button"
                          AutomationProperties.AutomationId="{Binding TestDelayAutomationId}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          Margin="0,0,11,9"
                          Command="{Binding #ProxyPageRoot.((vm:ProxyPageViewModel)DataContext).TestNodeDelayCommand}"
                          CommandParameter="{Binding Name}">
                    <Panel Height="18">
                      <TextBlock Classes="delay-badge"
                                 AutomationProperties.AutomationId="{Binding DelayAutomationId}"
                                 Tag="{Binding DelayLevel}"
                                 IsVisible="{Binding !IsDelayTesting}"
                                 Text="{Binding DelayText}"
                                 VerticalAlignment="Center" />
                      <iconPacks:PackIconMingCuteIcons Classes="delay-spinner"
                                                        AutomationProperties.AutomationId="{Binding DelayTestingAutomationId}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding IsDelayTesting}"
                                                        Kind="LoadingFill" />
                    </Panel>
                  </Button>
                  <Button Classes="node-action-button"
                          AutomationProperties.AutomationId="{Binding ActionAutomationId}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          Margin="0,13,5,0"
                          IsVisible="{Binding HasAction}"
                          Command="{Binding #ProxyPageRoot.((vm:ProxyPageViewModel)DataContext).NodeCardActionCommand}"
                          CommandParameter="{Binding}"
                          Click="OnNodeActionButtonClick">
                    <FlyoutBase.AttachedFlyout>
                      <Flyout Placement="BottomEdgeAlignedRight"
                              FlyoutPresenterClasses="node-action-flyout">
                        <Border Classes="card-menu-panel"
                                Width="220">
                          <ItemsControl ItemsSource="{Binding MenuOptions}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:ProxyNodeMenuSelection">
                                <Button Classes="card-menu-row"
                                        AutomationProperties.AutomationId="{Binding AutomationId}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Click="OnNodeMenuItemClick">
                                  <Grid ColumnDefinitions="24,*"
                                        ColumnSpacing="14">
                                    <iconPacks:PackIconMingCuteIcons Classes="card-menu-icon"
                                                                      Width="16"
                                                                      Height="16"
                                                                      Kind="{Binding IconType}"
                                                                      VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Classes="card-menu-text"
                                               Text="{Binding DisplayName}"
                                               VerticalAlignment="Center" />
                                  </Grid>
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Border>
                      </Flyout>
                    </FlyoutBase.AttachedFlyout>
                    <iconPacks:PackIconMingCuteIcons Width="16"
                                                      Height="16"
                                                      Kind="{Binding ActionIconType}" />
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

    </Grid>

    <controls:OverlayDialogHost Grid.RowSpan="2"
                                AutomationProperties.AutomationId="Proxy.DialogOverlay"
                                IsOpen="{Binding IsDialogOverlayVisible}">
      <controls:OverlayDialogHost.DialogContent>
        <Grid>
          <controls:DialogPanel PanelWidth="460"
                                AutomationProperties.AutomationId="Proxy.NodeInformationDialog"
                                IsOpen="{Binding IsNodeInformationDialogVisible}">
            <controls:DialogPanel.DialogContent>
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <TextBlock Classes="dialog-title"
                             Text="{loc:Loc Proxy.NodeInformation.Title}"
                             VerticalAlignment="Center" />
                  <Button Grid.Column="1"
                          Classes="dialog-close"
                          AutomationProperties.AutomationId="Proxy.NodeInformationDialog.HeaderCloseButton"
                          Command="{Binding CloseNodeInformationDialogCommand}">
                    <iconPacks:PackIconMingCuteIcons Width="16" Height="16" Kind="CloseFill" />
                  </Button>
                </Grid>

                <Border Classes="dialog-section">
                  <StackPanel Spacing="0">
                    <Border Classes="connection-detail-row dense">
                      <Grid ColumnDefinitions="104,*" ColumnSpacing="12">
                        <TextBlock Classes="dialog-label" Text="{loc:Loc Proxy.NodeInformation.Name}" />
                        <TextBlock Grid.Column="1" Classes="connection-detail-value"
                                   Text="{Binding NodeInformationName}" />
                      </Grid>
                    </Border>
                    <Border Classes="connection-detail-row dense">
                      <Grid ColumnDefinitions="104,*" ColumnSpacing="12">
                        <TextBlock Classes="dialog-label" Text="{loc:Loc Proxy.NodeInformation.Type}" />
                        <TextBlock Grid.Column="1" Classes="connection-detail-value"
                                   Text="{Binding NodeInformationType}" />
                      </Grid>
                    </Border>
                    <Border Classes="connection-detail-row dense">
                      <Grid ColumnDefinitions="104,*" ColumnSpacing="12">
                        <TextBlock Classes="dialog-label" Text="{loc:Loc Proxy.NodeInformation.Server}" />
                        <TextBlock Grid.Column="1" Classes="connection-detail-value"
                                   Text="{Binding NodeInformationServer}" />
                      </Grid>
                    </Border>
                    <Border Classes="connection-detail-row dense">
                      <Grid ColumnDefinitions="104,*" ColumnSpacing="12">
                        <TextBlock Classes="dialog-label" Text="{loc:Loc Proxy.NodeInformation.Port}" />
                        <TextBlock Grid.Column="1" Classes="connection-detail-value"
                                   Text="{Binding NodeInformationPort}" />
                      </Grid>
                    </Border>
                    <Border Classes="connection-detail-row dense">
                      <Grid ColumnDefinitions="104,*" ColumnSpacing="12">
                        <TextBlock Classes="dialog-label" Text="{loc:Loc Proxy.NodeInformation.Provider}" />
                        <TextBlock Grid.Column="1" Classes="connection-detail-value"
                                   Text="{Binding NodeInformationProvider}" />
                      </Grid>
                    </Border>
                    <Border Classes="connection-detail-row dense">
                      <Grid ColumnDefinitions="104,*" ColumnSpacing="12">
                        <TextBlock Classes="dialog-label" Text="{loc:Loc Proxy.NodeInformation.Delay}" />
                        <TextBlock Grid.Column="1" Classes="connection-detail-value"
                                   Text="{Binding NodeInformationDelay}" />
                      </Grid>
                    </Border>
                  </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Classes="dialog-primary"
                          AutomationProperties.AutomationId="Proxy.NodeInformationDialog.CloseButton"
                          Command="{Binding CloseNodeInformationDialogCommand}"
                          Content="{loc:Loc Common.Close}" />
                </StackPanel>
              </StackPanel>
            </controls:DialogPanel.DialogContent>
          </controls:DialogPanel>

          <controls:DialogPanel PanelWidth="500"
                                AutomationProperties.AutomationId="Proxy.NodeShareDialog"
                                IsOpen="{Binding IsNodeShareDialogVisible}">
            <controls:DialogPanel.DialogContent>
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="dialog-title"
                               Text="{loc:Loc Proxy.NodeShare.Title}" />
                    <TextBlock Classes="dialog-subtitle"
                               Text="{Binding NodeShareFormat}" />
                  </StackPanel>
                  <Button Grid.Column="1"
                          Classes="dialog-close"
                          AutomationProperties.AutomationId="Proxy.NodeShareDialog.HeaderCloseButton"
                          Command="{Binding CloseNodeShareDialogCommand}">
                    <iconPacks:PackIconMingCuteIcons Width="16" Height="16" Kind="CloseFill" />
                  </Button>
                </Grid>

                <Border Width="200"
                        Height="200"
                        IsVisible="{Binding HasNodeShareQrCode}"
                        HorizontalAlignment="Center"
                        Background="White"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10"
                        AutomationProperties.AutomationId="Proxy.NodeShareDialog.PreviewBox">
                  <controls:QrCodeMatrixView AutomationProperties.AutomationId="Proxy.NodeShareDialog.Matrix"
                                             Matrix="{Binding NodeShareQrCodeMatrix}" />
                </Border>

                <Border Classes="dialog-section" MaxHeight="180">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock AutomationProperties.AutomationId="Proxy.NodeShareDialog.ContentText"
                               FontFamily="Consolas"
                               Text="{Binding NodeShareContent}"
                               TextWrapping="Wrap" />
                  </ScrollViewer>
                </Border>

                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right">
                  <Button Classes="dialog-secondary"
                          AutomationProperties.AutomationId="Proxy.NodeShareDialog.CopyButton"
                          Command="{Binding CopyNodeShareCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <iconPacks:PackIconMingCuteIcons Classes="icon" Width="14" Height="14" Kind="Copy2Line" />
                      <TextBlock Text="{loc:Loc Common.Copy}" />
                    </StackPanel>
                  </Button>
                  <Button Classes="dialog-primary"
                          AutomationProperties.AutomationId="Proxy.NodeShareDialog.CloseButton"
                          Command="{Binding CloseNodeShareDialogCommand}"
                          Content="{loc:Loc Common.Close}" />
                </StackPanel>
              </StackPanel>
            </controls:DialogPanel.DialogContent>
          </controls:DialogPanel>
        </Grid>
      </controls:OverlayDialogHost.DialogContent>
    </controls:OverlayDialogHost>
  </Grid>
</UserControl>
