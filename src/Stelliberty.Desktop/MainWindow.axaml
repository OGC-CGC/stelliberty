<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Stelliberty.Desktop.Controls"
        xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
        xmlns:loc="using:Stelliberty.Desktop.Localization"
        xmlns:views="using:Stelliberty.Desktop.Views"
        xmlns:dialogs="using:Stelliberty.Desktop.Views.Dialogs"
        xmlns:vm="using:Stelliberty.Presentation.ViewModels"
        x:Class="Stelliberty.Desktop.MainWindow"
        x:CompileBindings="True"
        x:DataType="vm:MainWindowViewModel"
        Width="1040"
        Height="840"
        MinWidth="896"
        MinHeight="586"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="36"
        TransparencyLevelHint="None"
        Background="{DynamicResource AppRootSurfaceBrush}"
        UseLayoutRounding="True"
        Title="{Binding Title}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://stelliberty_ui/Styles/Theme.axaml" />
        <ResourceInclude Source="avares://stelliberty_ui/Styles/BrandTitle.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <views:PageToViewConverter x:Key="PageToView" />
    </ResourceDictionary>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Path.brand-title">
      <Setter Property="Data" Value="{StaticResource SidebarBrandGeometry}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
    </Style>
    <Style Selector="Path.brand-title.outline">
      <Setter Property="Fill" Value="{DynamicResource AppBrandTitleOutlineBrush}" />
    </Style>
    <StyleInclude Source="avares://stelliberty_ui/Styles/ShellStyles.axaml" />
    <StyleInclude Source="avares://stelliberty_ui/Styles/PrimitivesStyles.axaml" />
    <StyleInclude Source="avares://stelliberty_ui/Styles/ScrollStyles.axaml" />
    <StyleInclude Source="avares://stelliberty_ui/Styles/ListPageStyles.axaml" />
    <StyleInclude Source="avares://stelliberty_ui/Styles/HomeStyles.axaml" />
    <StyleInclude Source="avares://stelliberty_ui/Styles/ProxyStyles.axaml" />
    <StyleInclude Source="avares://stelliberty_ui/Styles/ComboBoxStyles.axaml" />
    <StyleInclude Source="avares://stelliberty_ui/Styles/MenuStyles.axaml" />
    <StyleInclude Source="avares://stelliberty_ui/Styles/SwitchStyles.axaml" />
    <StyleInclude Source="avares://stelliberty_ui/Styles/DialogStyles.axaml" />
    <StyleInclude Source="avares://stelliberty_ui/Styles/ToastStyles.axaml" />
    <StyleInclude Source="avares://stelliberty_ui/Styles/SettingsStyles.axaml" />
    <Style Selector="Border.sidebar-shadow.divider-hidden">
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
  </Window.Styles>

  <Grid x:Name="RootGrid" RowDefinitions="36,*">
    <!-- Linux 无模糊合成器时，用不透明底色替代窗口 93% alpha，避免透出桌面。 -->
    <Border x:Name="BaseColorLayer" Grid.RowSpan="2"
            Background="{DynamicResource AppBaseColorBrush}"
            IsHitTestVisible="False"
            IsVisible="False"
            AutomationProperties.AccessibilityView="Raw" />
    <Border x:Name="BackgroundImageLayer" Grid.RowSpan="2"
            IsHitTestVisible="False" ClipToBounds="True"
            AutomationProperties.AccessibilityView="Raw" />
    <Border x:Name="TitleBarSurface"
            AutomationProperties.AutomationId="TitleBar.Root"
            Background="Transparent"
            PointerPressed="OnTitleBarPointerPressed">
      <Grid x:Name="TitleBarLayout" ColumnDefinitions="Auto,*,Auto,Auto">
        <Border Grid.Column="0"
                HorizontalAlignment="Left"
                Classes="sidebar-shadow sidebar-width"
                Classes.divider-hidden="{Binding !Theme.IsSidebarDividerVisible}"
                IsHitTestVisible="False" />
        <!-- macOS 风格：左侧四颗圆点（关闭/最小化/最大化/置顶），符号悬停显示。
             左边距 4 = 一个间距(8) − 圆点在按钮内的 4px 内缩，使第一颗圆点左边缘 = 8px。 -->
        <StackPanel x:Name="MacCaptionButtons"
                    Grid.Column="0"
                    Classes="mac-caption"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="4,0,0,0"
                    IsVisible="False">
          <Button x:Name="MacCloseButton"
                  Classes="mac-caption-button close"
                  AutomationProperties.AutomationId="TitleBar.MacCloseButton"
                  Click="OnCloseClicked">
            <Grid Width="15" Height="15">
              <Border Classes="mac-caption-dot" />
              <Path Classes="mac-caption-glyph"
                    Data="M 4.5 4.5 L 10.5 10.5 M 10.5 4.5 L 4.5 10.5"
                    StrokeThickness="1.5"
                    StrokeLineCap="Round" />
            </Grid>
          </Button>
          <Button x:Name="MacMinimizeButton"
                  Classes="mac-caption-button minimize"
                  AutomationProperties.AutomationId="TitleBar.MacMinimizeButton"
                  Click="OnMinimizeClicked">
            <Grid Width="15" Height="15">
              <Border Classes="mac-caption-dot" />
              <Path Classes="mac-caption-glyph"
                    Data="M 4.5 7.5 L 10.5 7.5"
                    StrokeThickness="1.8"
                    StrokeLineCap="Round" />
            </Grid>
          </Button>
          <Button x:Name="MacMaximizeButton"
                  Classes="mac-caption-button zoom"
                  AutomationProperties.AutomationId="TitleBar.MacMaximizeButton"
                  Click="OnMacZoomClicked">
            <Grid Width="15" Height="15">
              <Border Classes="mac-caption-dot" />
              <Path Classes="mac-caption-glyph"
                    Data="M 4.5 9 V 4.5 H 9 Z M 10.5 6 V 10.5 H 6 Z" />
            </Grid>
          </Button>
          <Button x:Name="MacPinButton"
                  Classes="mac-caption-button pin"
                  AutomationProperties.AutomationId="TitleBar.MacPinButton"
                  Click="OnPinClicked">
            <Grid Width="15" Height="15">
              <Border Classes="mac-caption-dot" />
              <iconPacks:PackIconMingCuteIcons x:Name="MacPinFilledIcon"
                                               Width="8" Height="8"
                                               Classes="mac-caption-glyph"
                                               Kind="PinFill" />
            </Grid>
          </Button>
        </StackPanel>
        <controls:FpsCounter Grid.Column="2"
                             AutomationProperties.AutomationId="TitleBar.FpsCounter"
                             IsVisible="{Binding AppBehavior.IsTitleBarFpsVisible}"
                             IsHitTestVisible="False"
                             VerticalAlignment="Center"
                             Margin="0,0,10,0"
                             FontFamily="Consolas"
                             FontSize="11"
                             FontWeight="Normal"
                             Foreground="{DynamicResource AppTextSecondaryBrush}" />
        <StackPanel x:Name="WindowsTitleBarGroup"
                    Grid.Column="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch">
          <!-- 图钉：Windows/Linux 位于窗口按钮左侧，macOS 位于标题栏最右侧。 -->
          <Button x:Name="PinButton"
                  Classes="titlebar-button pin"
                  AutomationProperties.AutomationId="TitleBar.PinButton"
                  AutomationProperties.Name="{loc:Loc TitleBar.Tooltip.Pin}"
                  ToolTip.Tip="{loc:Loc TitleBar.Tooltip.Pin}"
                  Click="OnPinClicked">
            <Grid Width="15" Height="15">
              <iconPacks:PackIconMingCuteIcons x:Name="PinOutlineIcon"
                                               Width="15" Height="15"
                                               Kind="PinLine"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              <iconPacks:PackIconMingCuteIcons x:Name="PinFilledIcon"
                                               Width="15" Height="15"
                                               Kind="PinFill"
                                               IsVisible="False"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Grid>
          </Button>
          <StackPanel x:Name="CaptionButtons"
                      Orientation="Horizontal"
                      VerticalAlignment="Stretch">
            <Button Classes="titlebar-button"
                    AutomationProperties.AutomationId="TitleBar.MinimizeButton"
                    Click="OnMinimizeClicked">
              <Path Width="15" Height="15"
                    Data="M 2 6 L 10 6"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.4"
                    StrokeLineCap="Square" />
            </Button>
            <Button Classes="titlebar-button"
                    AutomationProperties.AutomationId="TitleBar.MaximizeButton"
                    Click="OnMaximizeClicked">
              <Grid Width="15" Height="15">
                <Rectangle x:Name="MaximizeIcon" Width="9" Height="9"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                           StrokeThickness="1.25" />
                <Path x:Name="RestoreIcon" IsVisible="False"
                      Data="M 4 2.5 H 9.5 V 8 M 2.5 4 H 8 V 9.5 H 2.5 Z"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.25" />
              </Grid>
            </Button>
            <Button Classes="titlebar-button close"
                    AutomationProperties.AutomationId="TitleBar.CloseButton"
                    Click="OnCloseClicked">
              <Path Width="15" Height="15"
                    Data="M 3 3 L 9 9 M 9 3 L 3 9"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.45"
                    StrokeLineCap="Round" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ClipToBounds="True">
      <Border AutomationProperties.AutomationId="Sidebar.Root"
              Classes="sidebar-shadow sidebar-width"
              Classes.divider-hidden="{Binding !Theme.IsSidebarDividerVisible}"
              Padding="12,24,12,20"
              Background="Transparent">
        <Grid x:Name="SidebarLayout" RowDefinitions="Auto,*,Auto">
          <!-- 选中底板：跨导航项平移，而不是在每一项上单独出现。 -->
          <Border x:Name="NavSelectionIndicator"
                  Grid.RowSpan="3"
                  Classes="nav-selection-indicator"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  IsHitTestVisible="False"
                  Opacity="0"
                  AutomationProperties.AccessibilityView="Raw" />
          <Button Classes="sidebar-toggle"
                  Margin="0,4,0,28"
                  AutomationProperties.AutomationId="Sidebar.ToggleButton"
                  AutomationProperties.Name="{Binding Title}"
                  Click="OnSidebarToggleClicked">
            <!-- 固定展开时的内容宽度，避免侧栏动画带动 Logo 的布局锚点。 -->
            <Grid Width="195" HorizontalAlignment="Left">
              <Grid Classes="sidebar-brand" MinHeight="36"
                    HorizontalAlignment="Center">
                <Path Classes="brand-title outline">
                  <Path.RenderTransform><TranslateTransform X="-1" Y="-1" /></Path.RenderTransform>
                </Path>
                <Path Classes="brand-title outline">
                  <Path.RenderTransform><TranslateTransform Y="-1" /></Path.RenderTransform>
                </Path>
                <Path Classes="brand-title outline">
                  <Path.RenderTransform><TranslateTransform X="1" Y="-1" /></Path.RenderTransform>
                </Path>
                <Path Classes="brand-title outline">
                  <Path.RenderTransform><TranslateTransform X="-1" /></Path.RenderTransform>
                </Path>
                <Path Classes="brand-title outline">
                  <Path.RenderTransform><TranslateTransform X="1" /></Path.RenderTransform>
                </Path>
                <Path Classes="brand-title outline">
                  <Path.RenderTransform><TranslateTransform X="-1" Y="1" /></Path.RenderTransform>
                </Path>
                <Path Classes="brand-title outline">
                  <Path.RenderTransform><TranslateTransform Y="1" /></Path.RenderTransform>
                </Path>
                <Path Classes="brand-title outline">
                  <Path.RenderTransform><TranslateTransform X="1" Y="1" /></Path.RenderTransform>
                </Path>

                <Path Classes="brand-title">
                  <Path.Fill>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                      <GradientStop Offset="0" Color="{DynamicResource AppBrandTitleStartColor}" />
                      <GradientStop Offset="0.38" Color="{DynamicResource AppBrandTitleMiddleColor}" />
                      <GradientStop Offset="1" Color="{DynamicResource AppBrandTitleEndColor}" />
                    </LinearGradientBrush>
                  </Path.Fill>
                </Path>
                <TextBlock AutomationProperties.AutomationId="Sidebar.BrandText"
                           Text="{Binding Title}"
                           FontSize="27" Foreground="Transparent"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False" />
              </Grid>
              <Image Classes="sidebar-app-icon"
                     Source="avares://stelliberty_ui/Assets/sidebar/app_icon.png"
                     Width="36" Height="36"
                     HorizontalAlignment="Left" Margin="7,0,0,0"
                     Stretch="Uniform"
                     IsHitTestVisible="False" />
            </Grid>
          </Button>

          <ScrollViewer x:Name="SidebarNavigationScroll"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Hidden"
                        ScrollChanged="OnSidebarScrollChanged">
            <StackPanel Spacing="6">
              <Button Classes="nav-item"
                      x:Name="NavHomeButton"
                      AutomationProperties.AutomationId="Navigation.HomeButton"
                      AutomationProperties.Name="{Binding HomeNavText}"
                      ToolTip.Tip="{Binding HomeNavText}"
                      Command="{Binding ShowHomeCommand}">
                <Grid Classes="nav-item-layout" ColumnDefinitions="34,*,Auto">
                  <Border Grid.Column="0" Classes="nav-icon-pill"><iconPacks:PackIconMingCuteIcons Classes="icon nav-icon nav-icon-home" /></Border>
                  <TextBlock Grid.Column="1" Text="{Binding HomeNavText}" Classes="nav-label" VerticalAlignment="Center" FontSize="14" />
                  <Border Grid.Column="2" Classes="nav-label-spacer" Width="34" />
                </Grid>
              </Button>
              <Button Classes="nav-item"
                      x:Name="NavProxyButton"
                      AutomationProperties.AutomationId="Navigation.ProxyButton"
                      AutomationProperties.Name="{Binding ProxyNavText}"
                      ToolTip.Tip="{Binding ProxyNavText}"
                      Command="{Binding ShowProxyCommand}">
                <Grid Classes="nav-item-layout" ColumnDefinitions="34,*,Auto">
                  <Border Grid.Column="0" Classes="nav-icon-pill"><iconPacks:PackIconMingCuteIcons Classes="icon nav-icon nav-icon-proxy" /></Border>
                  <TextBlock Grid.Column="1" Text="{Binding ProxyNavText}" Classes="nav-label" VerticalAlignment="Center" FontSize="14" />
                  <Border Grid.Column="2" Classes="nav-label-spacer" Width="34" />
                </Grid>
              </Button>
              <Button Classes="nav-item"
                      x:Name="NavConnectionsButton"
                      AutomationProperties.AutomationId="Navigation.ConnectionsButton"
                      AutomationProperties.Name="{Binding ConnectionsNavText}"
                      ToolTip.Tip="{Binding ConnectionsNavText}"
                      Command="{Binding ShowConnectionsCommand}">
                <Grid Classes="nav-item-layout" ColumnDefinitions="34,*,Auto">
                  <Border Grid.Column="0" Classes="nav-icon-pill"><iconPacks:PackIconMingCuteIcons Classes="icon nav-icon nav-icon-connections" /></Border>
                  <TextBlock Grid.Column="1" Text="{Binding ConnectionsNavText}" Classes="nav-label" VerticalAlignment="Center" FontSize="14" />
                  <Border Grid.Column="2" Classes="nav-label-spacer" Width="34" />
                </Grid>
              </Button>
              <Button Classes="nav-item"
                      x:Name="NavRulesButton"
                      AutomationProperties.AutomationId="Navigation.RulesButton"
                      AutomationProperties.Name="{Binding RulesNavText}"
                      ToolTip.Tip="{Binding RulesNavText}"
                      Command="{Binding ShowRulesCommand}">
                <Grid Classes="nav-item-layout" ColumnDefinitions="34,*,Auto">
                  <Border Grid.Column="0" Classes="nav-icon-pill"><iconPacks:PackIconMingCuteIcons Classes="icon nav-icon nav-icon-rules" /></Border>
                  <TextBlock Grid.Column="1" Text="{Binding RulesNavText}" Classes="nav-label" VerticalAlignment="Center" FontSize="14" />
                  <Border Grid.Column="2" Classes="nav-label-spacer" Width="34" />
                </Grid>
              </Button>
              <Button Classes="nav-item"
                      x:Name="NavSubscriptionsButton"
                      AutomationProperties.AutomationId="Navigation.SubscriptionsButton"
                      AutomationProperties.Name="{Binding SubscriptionsNavText}"
                      ToolTip.Tip="{Binding SubscriptionsNavText}"
                      Command="{Binding ShowSubscriptionsCommand}">
                <Grid Classes="nav-item-layout" ColumnDefinitions="34,*,Auto">
                  <Border Grid.Column="0" Classes="nav-icon-pill"><iconPacks:PackIconMingCuteIcons Classes="icon nav-icon nav-icon-subscription" /></Border>
                  <TextBlock Grid.Column="1" Text="{Binding SubscriptionsNavText}" Classes="nav-label" VerticalAlignment="Center" FontSize="14" />
                  <Border Grid.Column="2" Classes="nav-label-spacer" Width="34" />
                </Grid>
              </Button>
              <Button Classes="nav-item"
                      x:Name="NavOverridesButton"
                      AutomationProperties.AutomationId="Navigation.OverridesButton"
                      AutomationProperties.Name="{Binding OverridesNavText}"
                      ToolTip.Tip="{Binding OverridesNavText}"
                      Command="{Binding ShowOverridesCommand}">
                <Grid Classes="nav-item-layout" ColumnDefinitions="34,*,Auto">
                  <Border Grid.Column="0" Classes="nav-icon-pill"><iconPacks:PackIconMingCuteIcons Classes="icon nav-icon nav-icon-overrides" /></Border>
                  <TextBlock Grid.Column="1" Text="{Binding OverridesNavText}" Classes="nav-label" VerticalAlignment="Center" FontSize="14" />
                  <Border Grid.Column="2" Classes="nav-label-spacer" Width="34" />
                </Grid>
              </Button>
              <Button Classes="nav-item"
                      x:Name="NavCoreLogsButton"
                      AutomationProperties.AutomationId="Navigation.CoreLogsButton"
                      AutomationProperties.Name="{Binding CoreLogsNavText}"
                      ToolTip.Tip="{Binding CoreLogsNavText}"
                      Command="{Binding ShowCoreLogsCommand}">
                <Grid Classes="nav-item-layout" ColumnDefinitions="34,*,Auto">
                  <Border Grid.Column="0" Classes="nav-icon-pill"><iconPacks:PackIconMingCuteIcons Classes="icon nav-icon nav-icon-log" /></Border>
                  <TextBlock Grid.Column="1" Text="{Binding CoreLogsNavText}" Classes="nav-label" VerticalAlignment="Center" FontSize="14" />
                  <Border Grid.Column="2" Classes="nav-label-spacer" Width="34" />
                </Grid>
              </Button>
            </StackPanel>
          </ScrollViewer>

          <Button Grid.Row="2"
                  x:Name="NavSettingsButton"
                  Margin="0,12,0,0"
                  Classes="nav-item"
                  AutomationProperties.AutomationId="Navigation.SettingsButton"
                  AutomationProperties.Name="{Binding SettingsNavText}"
                  ToolTip.Tip="{Binding SettingsNavText}"
                  Command="{Binding ShowSettingsCommand}">
            <Grid Classes="nav-item-layout" ColumnDefinitions="34,*,Auto">
              <Border Grid.Column="0" Classes="nav-icon-pill"><iconPacks:PackIconMingCuteIcons Classes="icon nav-icon nav-icon-settings" /></Border>
              <TextBlock Grid.Column="1" Text="{Binding SettingsNavText}" Classes="nav-label" VerticalAlignment="Center" FontSize="14" />
              <Border Grid.Column="2" Classes="nav-label-spacer" Width="34" />
            </Grid>
          </Button>
        </Grid>
      </Border>

      <Border Grid.Column="1"
              Classes="content-host"
              Classes.settings="{Binding IsSettingsSelected}"
              Background="Transparent">
          <Grid>
            <ContentControl x:Name="HomePageHost" Classes="page-host" />
            <ContentControl x:Name="ProxyPageHost" Classes="page-host" />
            <ContentControl x:Name="ConnectionsPageHost" Classes="page-host" />
            <ContentControl x:Name="CoreLogsPageHost" Classes="page-host" />
            <ContentControl x:Name="RulesPageHost" Classes="page-host" />
            <ContentControl x:Name="SubscriptionsPageHost" Classes="page-host" />
            <ContentControl x:Name="OverridesPageHost" Classes="page-host" />
            <ContentControl x:Name="SettingsPageHost" Classes="page-host" />
            <!-- 加载层只拦截内容区，导航仍可切换页面。 -->
            <Border x:Name="PageLoadingOverlay"
                    ZIndex="50"
                    Opacity="0"
                    IsHitTestVisible="False"
                    Background="Transparent"
                    AutomationProperties.AutomationId="Shell.PageLoadingOverlay">
              <controls:PageLoadingIndicator x:Name="PageLoadingIndicator"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Center"
                                             Height="140"
                                             AutomationProperties.AutomationId="Shell.PageLoadingIndicator" />
            </Border>
          </Grid>
      </Border>
    </Grid>

    <controls:OverlayDialogHost x:Name="DialogHost"
                                Grid.RowSpan="2" />

    <views:SubscriptionProviderDialog Grid.RowSpan="2" DataContext="{Binding SubscriptionPage.Provider}" />

    <controls:OverlayDialogHost x:Name="ConnectivityDialogHost" Grid.RowSpan="2"
                                DataContext="{Binding HomePage}" x:DataType="vm:HomePageViewModel"
                                IsOpen="{Binding IsConnectivityEditorOpen}">
      <controls:OverlayDialogHost.DialogContent>
        <controls:DialogPanel PanelWidth="760" IsOpen="{Binding IsConnectivityEditorOpen}">
          <controls:DialogPanel.DialogContent>
            <dialogs:ConnectivityEditorView />
          </controls:DialogPanel.DialogContent>
        </controls:DialogPanel>
      </controls:OverlayDialogHost.DialogContent>
    </controls:OverlayDialogHost>

    <controls:OverlayDialogHost x:Name="UpdateDialogHost"
                                Grid.RowSpan="2"
                                AutomationProperties.AutomationId="Settings.UpdateDialogOverlay"
                                IsOpen="{Binding Update.IsUpdateDialogVisible}">
      <controls:OverlayDialogHost.DialogContent>
        <controls:DialogPanel PanelWidth="500"
                              ContentPadding="0"
                              AutomationProperties.AutomationId="Settings.UpdateDialog"
                              IsOpen="{Binding Update.IsUpdateDialogVisible}">
          <controls:DialogPanel.DialogContent>
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="18">
              <!-- 标题栏：徽章 + 标题 + 副说明，右上角关闭 -->
              <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Margin="24,24,24,0">
                <Border Classes="surface-card-badge" VerticalAlignment="Top">
                  <iconPacks:PackIconMingCuteIcons Width="20" Height="20" Kind="DownloadLine"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                  <TextBlock Classes="dialog-title"
                             Text="{loc:Loc Settings.Update.Dialog.Title}" />
                  <TextBlock Classes="dialog-subtitle"
                             Text="{loc:Loc Settings.Update.Dialog.Message}"
                             TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="2"
                        Classes="dialog-close"
                        VerticalAlignment="Top"
                        AutomationProperties.AutomationId="Settings.UpdateDialog.CloseButton"
                        Command="{Binding Update.CloseUpdateDialogCommand}">
                  <iconPacks:PackIconMingCuteIcons Width="16" Height="16" Kind="CloseFill" />
                </Button>
              </Grid>

              <!-- 版本对比：旧版 → 新版，新版加 .accent 强调 -->
              <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" ColumnSpacing="12" Margin="24,0,24,0">
                <Border Classes="update-version-slot">
                  <StackPanel Spacing="3">
                    <TextBlock Classes="uv-label" Text="{loc:Loc Settings.Update.CurrentVersion}" />
                    <TextBlock Classes="uv-value"
                               AutomationProperties.AutomationId="Settings.UpdateDialog.CurrentVersionText"
                               Text="{Binding Settings.AppVersionText}" />
                  </StackPanel>
                </Border>
                <iconPacks:PackIconMingCuteIcons Grid.Column="1" Width="18" Height="18" Kind="ArrowRightLine"
                                                 Foreground="{DynamicResource AppTextTertiaryBrush}"
                                                 VerticalAlignment="Center" />
                <Border Grid.Column="2" Classes="update-version-slot accent">
                  <StackPanel Spacing="3">
                    <TextBlock Classes="uv-label" Text="{loc:Loc Settings.Update.LatestVersion}" />
                    <TextBlock Classes="uv-value"
                               AutomationProperties.AutomationId="Settings.UpdateDialog.LatestVersionText"
                               Text="{Binding Update.LatestVersionText}" />
                  </StackPanel>
                </Border>
              </Grid>

              <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"
                          HorizontalAlignment="Right" Margin="24,0,24,24">
                <Button Classes="dialog-secondary"
                        AutomationProperties.AutomationId="Settings.UpdateDialog.LaterButton"
                        Command="{Binding Update.CloseUpdateDialogCommand}"
                        Content="{loc:Loc Common.Close}" />
                <Button Classes="dialog-primary"
                        AutomationProperties.AutomationId="Settings.UpdateDialog.OpenReleaseButton"
                        IsVisible="{Binding Update.CanOpenLatestRelease}"
                        Tag="{Binding Update.LatestReleaseUrl}"
                        Click="OnOpenUpdateReleaseClicked"
                        Content="{loc:Loc Settings.Update.OpenRelease}" />
              </StackPanel>
            </Grid>
          </controls:DialogPanel.DialogContent>
        </controls:DialogPanel>
      </controls:OverlayDialogHost.DialogContent>
    </controls:OverlayDialogHost>

    <controls:OverlayDialogHost x:Name="RestartRequiredDialogHost"
                                Grid.RowSpan="2"
                                AutomationProperties.AutomationId="Shell.RestartRequiredDialogOverlay">
      <controls:OverlayDialogHost.DialogContent>
        <controls:DialogPanel PanelWidth="460"
                              ContentPadding="0"
                              AutomationProperties.AutomationId="Shell.RestartRequiredDialog">
          <controls:DialogPanel.DialogContent>
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="24,24,24,0">
                <TextBlock Classes="dialog-title"
                           VerticalAlignment="Center"
                           Text="{loc:Loc Settings.WindowDecoration.Restart.Title}" />
                <Button Grid.Column="1"
                        Classes="dialog-close"
                        AutomationProperties.AutomationId="Shell.RestartRequiredDialog.CloseButton"
                        Click="OnRestartRequiredLaterClicked">
                  <iconPacks:PackIconMingCuteIcons Width="16" Height="16" Kind="CloseFill" />
                </Button>
              </Grid>
              <TextBlock Grid.Row="1"
                         Classes="dialog-subtitle"
                         Margin="24,0,22,0"
                         TextWrapping="Wrap"
                         Text="{loc:Loc Settings.WindowDecoration.Restart.Message}" />
              <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"
                          HorizontalAlignment="Right" Margin="24,4,24,24">
                <Button Classes="dialog-secondary"
                        AutomationProperties.AutomationId="Shell.RestartRequiredDialog.LaterButton"
                        Click="OnRestartRequiredLaterClicked"
                        Content="{loc:Loc Settings.WindowDecoration.Restart.Later}" />
                <Button Classes="dialog-primary"
                        AutomationProperties.AutomationId="Shell.RestartRequiredDialog.RestartButton"
                        Click="OnRestartRequiredRestartClicked"
                        Content="{loc:Loc Settings.WindowDecoration.Restart.Now}" />
              </StackPanel>
            </Grid>
          </controls:DialogPanel.DialogContent>
        </controls:DialogPanel>
      </controls:OverlayDialogHost.DialogContent>
    </controls:OverlayDialogHost>

    <controls:ToastNotification Grid.RowSpan="2"
                                IsOpen="{Binding IsToastVisible}"
                                Type="{Binding ToastType}"
                                Message="{Binding ToastMessage}" />
  </Grid>
</Window>
