<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="ToggleSwitch">
    <Setter Property="OnContent" Value="{x:Null}" />
    <Setter Property="OffContent" Value="{x:Null}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="44" />
    <Setter Property="MinHeight" Value="20" />

    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Width="44" Height="20" Background="Transparent">
          <Border x:Name="SwitchTrack"
                  Width="44" Height="20"
                  CornerRadius="10"
                  Background="{DynamicResource AppInputBrush}" />
          <Border x:Name="SwitchOnMark" Classes="switch-state-mark"
                  Width="2.5" Height="8" CornerRadius="1.25"
                  Margin="6.75,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                  Background="{DynamicResource AppOnAccentBrush}" Opacity="0" />
          <Ellipse x:Name="SwitchOffMark" Classes="switch-state-mark"
                   Width="6" Height="6" StrokeThickness="1.5"
                   Margin="0,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                   Stroke="{DynamicResource AppTextSecondaryBrush}" Opacity="0" />
          <Panel x:Name="PART_MovingKnobs" Width="0" Height="0" />

          <Border x:Name="SwitchThumb"
                  Width="26" Height="16"
                  CornerRadius="8"
                  Margin="2,0,0,0"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  Background="{DynamicResource AppTextSecondaryBrush}" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleSwitch /template/ Border#SwitchTrack">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.2" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ToggleSwitch /template/ Border#SwitchThumb">
    <Setter Property="Transitions">
      <Transitions>
        <ThicknessTransition Property="Margin" Duration="0:0:0.2" Easing="CubicEaseInOut" />
        <BrushTransition Property="Background" Duration="0:0:0.2" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ToggleSwitch /template/ :is(Control).switch-state-mark">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ Border#SwitchTrack">
    <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ Border#SwitchThumb">
    <Setter Property="Background" Value="{DynamicResource AppSwitchThumbOnBrush}" />
    <Setter Property="Margin" Value="16,0,0,0" />
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ Border#SwitchOnMark">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="ToggleSwitch:unchecked /template/ Ellipse#SwitchOffMark">
    <Setter Property="Opacity" Value="0.55" />
  </Style>
  <Style Selector="ToggleSwitch:indeterminate /template/ Border#SwitchTrack">
    <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <Style Selector="ToggleSwitch:indeterminate /template/ Border#SwitchThumb">
    <Setter Property="Background" Value="{DynamicResource AppSwitchThumbOnBrush}" />
    <!-- 中间态表示操作进行中：圆点贴向目标一侧，不停在轨道中央。 -->
    <Setter Property="Margin" Value="2,0,0,0" />
  </Style>
  <Style Selector="ToggleSwitch:indeterminate.on-target /template/ Border#SwitchThumb">
    <Setter Property="Margin" Value="16,0,0,0" />
  </Style>
  <Style Selector="ToggleSwitch:disabled:indeterminate">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="ToggleSwitch:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
</Styles>
