<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Stelliberty.Presentation.ViewModels"
        xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
        x:CompileBindings="True">
  <!-- 窗口外壳: 内容宿主、标题栏、侧边导航; 页面级与通用样式已拆出 -->

  <Styles.Resources>
    <ControlTemplate x:Key="Shell.PackIconMingCuteIcons.Template"
                     TargetType="iconPacks:PackIconMingCuteIcons">
      <Border CornerRadius="{TemplateBinding CornerRadius}"
              ClipToBounds="{TemplateBinding ClipToBounds}"
              Padding="{TemplateBinding Padding}"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}">
        <Grid x:Name="PART_InnerGrid"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              RenderTransformOrigin="0.5,0.5">
          <Viewbox Stretch="Uniform">
            <Grid>
              <Path Data="{TemplateBinding Data}"
                    Stretch="Uniform"
                    Fill="{TemplateBinding Foreground}"
                    UseLayoutRounding="False" />
            </Grid>
          </Viewbox>
        </Grid>
      </Border>
    </ControlTemplate>
  </Styles.Resources>

  <Style Selector="Border.content-host">
    <Setter Property="Padding" Value="8,0,3,0" />
  </Style>
  <Style Selector="Border.sidebar-shadow">
    <Setter Property="BorderBrush" Value="{DynamicResource AppSidebarDividerBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>
  <!-- 初始隐藏；进出过渡由 MainWindow 代码错峰驱动，避免两页叠加闪烁。 -->
  <Style Selector="ContentControl.page-host">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
  </Style>

  <Style Selector="iconPacks|PackIconMingCuteIcons">
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="FlowDirection" Value="LeftToRight" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template" Value="{StaticResource Shell.PackIconMingCuteIcons.Template}" />
  </Style>

  <Style Selector="Button.titlebar-button">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TitleBarButtonForegroundBrush}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}">
          <ContentPresenter HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.titlebar-button:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppOverlayBrush}" />
  </Style>
  <Style Selector="Button.titlebar-button.pin.active">
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
  </Style>
  <Style Selector="Button.titlebar-button.close:pointerover">
    <Setter Property="Background" Value="{DynamicResource TitleBarCloseButtonHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppOnDangerBrush}" />
  </Style>

  <!-- macOS 风格：左侧四颗圆点（关闭/最小化/最大化/置顶），符号仅在悬停时显示。 -->
  <Style Selector="Button.mac-caption-button">
    <Setter Property="Width" Value="23" />
    <Setter Property="Height" Value="15" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent">
          <ContentPresenter HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <!-- 圆点用 Border + 圆角（半径 = 半边长）保证正圆；圆 15px、按钮 23×15：
       高度与圆一致，左右各留 4px（间距 8px），全部落在整数像素上。 -->
  <Style Selector="Border.mac-caption-dot">
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
    <Setter Property="CornerRadius" Value="7.5" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.mac-caption-button.close Border.mac-caption-dot">
    <Setter Property="Background" Value="{DynamicResource MacCaptionDotCloseBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MacCaptionDotCloseBorderBrush}" />
  </Style>
  <Style Selector="Button.mac-caption-button.minimize Border.mac-caption-dot">
    <Setter Property="Background" Value="{DynamicResource MacCaptionDotMinimizeBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MacCaptionDotMinimizeBorderBrush}" />
  </Style>
  <Style Selector="Button.mac-caption-button.zoom Border.mac-caption-dot">
    <Setter Property="Background" Value="{DynamicResource MacCaptionDotZoomBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MacCaptionDotZoomBorderBrush}" />
  </Style>
  <Style Selector="Button.mac-caption-button.pin Border.mac-caption-dot">
    <Setter Property="Background" Value="{DynamicResource MacCaptionDotPinBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MacCaptionDotPinBorderBrush}" />
  </Style>
  <!-- 符号颜色与所在圆点同色相（浅色外观取中调、深色外观取浅调）。 -->
  <Style Selector="Button.mac-caption-button.close Path.mac-caption-glyph">
    <Setter Property="Stroke" Value="{DynamicResource MacCaptionGlyphCloseBrush}" />
  </Style>
  <Style Selector="Button.mac-caption-button.minimize Path.mac-caption-glyph">
    <Setter Property="Stroke" Value="{DynamicResource MacCaptionGlyphMinimizeBrush}" />
  </Style>
  <Style Selector="Button.mac-caption-button.zoom Path.mac-caption-glyph">
    <Setter Property="Fill" Value="{DynamicResource MacCaptionGlyphZoomBrush}" />
  </Style>
  <Style Selector="Button.mac-caption-button.pin iconPacks|PackIconMingCuteIcons.mac-caption-glyph">
    <Setter Property="Foreground" Value="{DynamicResource MacCaptionGlyphPinBrush}" />
  </Style>
  <!-- 窗口未激活时四颗圆点转为半透明灰阶渐变（macOS 行为）。 -->
  <Style Selector="Window.window-inactive Button.mac-caption-button Border.mac-caption-dot">
    <Setter Property="Background" Value="{DynamicResource MacCaptionInactiveDotBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MacCaptionInactiveDotStrokeBrush}" />
  </Style>
  <!-- 已置顶的紫色圆点保持原色，不随窗口失焦变灰。 -->
  <Style Selector="Window.window-inactive Button.mac-caption-button.pin.active Border.mac-caption-dot">
    <Setter Property="Background" Value="{DynamicResource MacCaptionDotPinBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MacCaptionDotPinBorderBrush}" />
  </Style>
  <!-- 圆点变灰时符号同步转灰；置顶的紫色圆点保持原色。 -->
  <Style Selector="Window.window-inactive Button.mac-caption-button.close Path.mac-caption-glyph">
    <Setter Property="Stroke" Value="{DynamicResource MacCaptionInactiveGlyphBrush}" />
  </Style>
  <Style Selector="Window.window-inactive Button.mac-caption-button.minimize Path.mac-caption-glyph">
    <Setter Property="Stroke" Value="{DynamicResource MacCaptionInactiveGlyphBrush}" />
  </Style>
  <Style Selector="Window.window-inactive Button.mac-caption-button.zoom Path.mac-caption-glyph">
    <Setter Property="Fill" Value="{DynamicResource MacCaptionInactiveGlyphBrush}" />
  </Style>
  <Style Selector="Window.window-inactive Button.mac-caption-button.pin iconPacks|PackIconMingCuteIcons.mac-caption-glyph">
    <Setter Property="Foreground" Value="{DynamicResource MacCaptionInactiveGlyphBrush}" />
  </Style>
  <Style Selector="Window.window-inactive Button.mac-caption-button.pin.active iconPacks|PackIconMingCuteIcons.mac-caption-glyph">
    <Setter Property="Foreground" Value="{DynamicResource MacCaptionGlyphPinBrush}" />
  </Style>
  <!-- 未激活时悬停到哪颗，哪颗就恢复本来的颜色（移开恢复灰），符号同步恢复本色。 -->
  <Style Selector="Window.window-inactive Button.mac-caption-button.close:pointerover Border.mac-caption-dot">
    <Setter Property="Background" Value="{DynamicResource MacCaptionDotCloseBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MacCaptionDotCloseBorderBrush}" />
  </Style>
  <Style Selector="Window.window-inactive Button.mac-caption-button.minimize:pointerover Border.mac-caption-dot">
    <Setter Property="Background" Value="{DynamicResource MacCaptionDotMinimizeBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MacCaptionDotMinimizeBorderBrush}" />
  </Style>
  <Style Selector="Window.window-inactive Button.mac-caption-button.zoom:pointerover Border.mac-caption-dot">
    <Setter Property="Background" Value="{DynamicResource MacCaptionDotZoomBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MacCaptionDotZoomBorderBrush}" />
  </Style>
  <Style Selector="Window.window-inactive Button.mac-caption-button.pin:pointerover Border.mac-caption-dot">
    <Setter Property="Background" Value="{DynamicResource MacCaptionDotPinBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MacCaptionDotPinBorderBrush}" />
  </Style>
  <Style Selector="Window.window-inactive Button.mac-caption-button.close:pointerover Path.mac-caption-glyph">
    <Setter Property="Stroke" Value="{DynamicResource MacCaptionGlyphCloseBrush}" />
  </Style>
  <Style Selector="Window.window-inactive Button.mac-caption-button.minimize:pointerover Path.mac-caption-glyph">
    <Setter Property="Stroke" Value="{DynamicResource MacCaptionGlyphMinimizeBrush}" />
  </Style>
  <Style Selector="Window.window-inactive Button.mac-caption-button.zoom:pointerover Path.mac-caption-glyph">
    <Setter Property="Fill" Value="{DynamicResource MacCaptionGlyphZoomBrush}" />
  </Style>
  <Style Selector="Window.window-inactive Button.mac-caption-button.pin:pointerover iconPacks|PackIconMingCuteIcons.mac-caption-glyph">
    <Setter Property="Foreground" Value="{DynamicResource MacCaptionGlyphPinBrush}" />
  </Style>
  <Style Selector="Path.mac-caption-glyph">
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="StackPanel.mac-caption:pointerover Path.mac-caption-glyph">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="iconPacks|PackIconMingCuteIcons.mac-caption-glyph">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <!-- 悬停四颗中任意一颗时，四个符号一起显示（联动）。 -->
  <Style Selector="StackPanel.mac-caption:pointerover iconPacks|PackIconMingCuteIcons.mac-caption-glyph">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <!-- 已置顶时常显实心图钉。 -->
  <Style Selector="Button.mac-caption-button.pin.active iconPacks|PackIconMingCuteIcons.mac-caption-glyph">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="Border.debug-badge">
    <Setter Property="Margin" Value="12,0,0,0" />
    <Setter Property="Padding" Value="9,2" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Background" Value="{DynamicResource DebugBadgeBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DebugBadgeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style Selector="TextBlock.debug-badge-text">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.8" />
    <Setter Property="Foreground" Value="{DynamicResource DebugBadgeForegroundBrush}" />
  </Style>

  <Style Selector="Border.sidebar-width">
    <Setter Property="Width" Value="220" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Width" Duration="0:0:0.24" Easing="CubicEaseInOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Window.sidebar-collapsed Border.sidebar-width">
    <!-- 74 = 分割线所在像素列 73 + 1。73 正好是红绿灯第 3、4 颗之间间隙的中心
         （按钮左边距 4 + 圆点在按钮内缩进 4 = 8 起，第 3、4 颗间隙中心 = 4 + 69 = 73）；
         同时收起态内容中心 12 + 8 + 17 = 37 = 74 / 2，内容在分割线内居中。 -->
    <Setter Property="Width" Value="74" />
  </Style>

  <Style Selector="Button.sidebar-toggle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                CornerRadius="8">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Image.sidebar-app-icon">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform" Value="translateX(-44px)" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.24" Easing="CubicEaseInOut" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.24" Easing="CubicEaseInOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Window.sidebar-collapsed Image.sidebar-app-icon">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="translateX(0px)" />
  </Style>
  <Style Selector="Grid.sidebar-brand">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.24" Easing="CubicEaseInOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Window.sidebar-collapsed Grid.sidebar-brand">
    <!-- 保留文字 Logo 的高度占位，避免收起后顶部 Auto 行变矮。 -->
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <Style Selector="Window.sidebar-collapsed TextBlock.nav-label">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <Style Selector="Button.nav-item">
    <Setter Property="ToolTip.ServiceEnabled" Value="False" />
  </Style>
  <Style Selector="Window.sidebar-collapsed Button.nav-item">
    <Setter Property="ToolTip.ServiceEnabled" Value="True" />
  </Style>

  <Style Selector="Button.nav-item">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="8,8" />
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.12" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="NavRoot"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.nav-item:pointerover /template/ Border#NavRoot">
    <Setter Property="Background" Value="{DynamicResource AppOverlayBrush}" />
  </Style>
  <!-- 选中项不再自绘底板，由 NavSelectionIndicator 从上一项平移过来。 -->
  <Style Selector="Button.nav-item.selected /template/ Border#NavRoot">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.nav-item.selected:pointerover /template/ Border#NavRoot">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.nav-item.selected">
    <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <Style Selector="Border.nav-selection-indicator">
    <Setter Property="Width" Value="0" />
    <Setter Property="Height" Value="0" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <ThicknessTransition Property="Margin" Duration="0:0:0.22" Easing="CubicEaseOut" />
        <DoubleTransition Property="Width" Duration="0:0:0.22" Easing="CubicEaseOut" />
        <DoubleTransition Property="Height" Duration="0:0:0.22" Easing="CubicEaseOut" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.14" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.nav-icon-pill">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.nav-item.selected iconPacks|PackIconMingCuteIcons">
    <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
  </Style>

  <Style Selector="Window.frutiger-aero Border.nav-selection-indicator">
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="{DynamicResource AppSurfaceListShadow}" />
  </Style>
  <Style Selector="Window.frutiger-aero Button.nav-item.selected">
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
  </Style>
  <Style Selector="Window.frutiger-aero Button.nav-item.selected iconPacks|PackIconMingCuteIcons">
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
  </Style>

  <Style Selector="iconPacks|PackIconMingCuteIcons.nav-icon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.12" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="iconPacks|PackIconMingCuteIcons.nav-icon-home">
    <Setter Property="Kind" Value="Home3Line" />
  </Style>

  <Style Selector="iconPacks|PackIconMingCuteIcons.nav-icon-proxy">
    <Setter Property="Kind" Value="SafariLine" />
  </Style>

  <Style Selector="iconPacks|PackIconMingCuteIcons.nav-icon-connections">
    <Setter Property="Kind" Value="TransferHorizontalLine" />
  </Style>

  <Style Selector="iconPacks|PackIconMingCuteIcons.nav-icon-log">
    <Setter Property="Kind" Value="FileCodeLine" />
    <Setter Property="RenderTransform">
      <TranslateTransform Y="0" />
    </Setter>
  </Style>

  <Style Selector="iconPacks|PackIconMingCuteIcons.nav-icon-rules">
    <Setter Property="Kind" Value="PencilRulerLine" />
  </Style>

  <Style Selector="iconPacks|PackIconMingCuteIcons.nav-icon-subscription">
    <Setter Property="Kind" Value="ServerLine" />
    <Setter Property="RenderTransform">
      <TranslateTransform Y="0" />
    </Setter>
  </Style>

  <Style Selector="iconPacks|PackIconMingCuteIcons.nav-icon-overrides">
    <Setter Property="Kind" Value="EditLine" />
  </Style>

  <Style Selector="iconPacks|PackIconMingCuteIcons.nav-icon-settings">
    <Setter Property="Kind" Value="Settings3Line" />
  </Style>

  <Style Selector="Button.nav-item.nav-icon-morph iconPacks|PackIconMingCuteIcons.nav-icon-home">
    <Setter Property="Kind" Value="Home3Fill" />
  </Style>

  <Style Selector="Button.nav-item.nav-icon-morph iconPacks|PackIconMingCuteIcons.nav-icon-proxy">
    <Setter Property="Kind" Value="SafariFill" />
  </Style>

  <Style Selector="Button.nav-item.nav-icon-morph iconPacks|PackIconMingCuteIcons.nav-icon-connections">
    <Setter Property="Kind" Value="TransferHorizontalFill" />
  </Style>

  <Style Selector="Button.nav-item.nav-icon-morph iconPacks|PackIconMingCuteIcons.nav-icon-log">
    <Setter Property="Kind" Value="FileCodeFill" />
  </Style>

  <Style Selector="Button.nav-item.nav-icon-morph iconPacks|PackIconMingCuteIcons.nav-icon-rules">
    <Setter Property="Kind" Value="PencilRulerFill" />
  </Style>

  <Style Selector="Button.nav-item.nav-icon-morph iconPacks|PackIconMingCuteIcons.nav-icon-subscription">
    <Setter Property="Kind" Value="ServerFill" />
  </Style>

  <Style Selector="Button.nav-item.nav-icon-morph iconPacks|PackIconMingCuteIcons.nav-icon-overrides">
    <Setter Property="Kind" Value="EditFill" />
  </Style>

  <Style Selector="Button.nav-item.nav-icon-morph iconPacks|PackIconMingCuteIcons.nav-icon-settings">
    <Setter Property="Kind" Value="Settings3Fill" />
  </Style>

  <Style Selector="TextBlock.nav-label" x:DataType="vm:MainWindowViewModel">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.24" Easing="CubicEaseInOut" />
      </Transitions>
    </Setter>
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LetterSpacing" Value="{Binding NavLabelLetterSpacing}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</Styles>
