<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Stelliberty.Desktop.Controls"
             xmlns:loc="using:Stelliberty.Desktop.Localization"
             xmlns:vm="using:Stelliberty.Presentation.ViewModels"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             xmlns:conv="using:Stelliberty.Desktop.Converters"
             x:Class="Stelliberty.Desktop.Views.SettingsView"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel"
             controls:InputDefocusBehavior.IsEnabled="True"
             AutomationProperties.AutomationId="Settings.Root"
             Background="Transparent">
  <UserControl.Resources>
    <conv:SettingsSubPageIconConverter x:Key="SettingsSubPageIcon" />
  </UserControl.Resources>
  <Border AutomationProperties.AutomationId="Settings.Page" Background="Transparent">
    <Grid RowDefinitions="Auto,*" Margin="0,12,0,0">
      <!-- 面包屑导航：根页面显示当前页标题，子页面可逐级回退。 -->
      <Border Classes="settings-breadcrumb"
              Margin="0,0,9,6"
              AutomationProperties.AutomationId="Settings.Breadcrumb">
        <ItemsControl ItemsSource="{Binding Settings.Breadcrumbs}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SettingsBreadcrumbItem">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <iconPacks:PackIconMingCuteIcons Classes="settings-breadcrumb-icon"
                                                 Kind="{Binding Page, Converter={StaticResource SettingsSubPageIcon}}" />
                <Button Classes="settings-breadcrumb-link"
                        Content="{Binding Text}"
                        Command="{Binding Command}"
                        IsVisible="{Binding CanNavigate}" />
                <TextBlock Classes="settings-breadcrumb-current"
                           Text="{Binding Text}"
                           IsVisible="{Binding !CanNavigate}" />
                <Path Classes="settings-breadcrumb-separator"
                      Margin="6,0,6,0"
                      Data="M 0.5 0.5 L 4 3.5 L 0.5 6.5"
                      IsVisible="{Binding ShowSeparator}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <ScrollViewer Grid.Row="1"
                    x:Name="SettingsScroll"
                    AutomationProperties.AutomationId="Settings.ScrollViewer"
                    controls:ScrollEdgeFade.IsEnabled="True"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <!-- 承载全部设置子页面板 -->
        <!-- 设置子页按当前路由创建，避免隐藏面板常驻视觉树。 -->
        <ContentControl x:Name="SettingsContentPanel"
                        Margin="0,0,9,15"
                        HorizontalAlignment="Stretch"
                        RenderTransformOrigin="50%,50%" />
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
