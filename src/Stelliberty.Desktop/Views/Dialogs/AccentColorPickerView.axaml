<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             xmlns:primitives="using:Avalonia.Controls.Primitives"
             xmlns:vm="using:Stelliberty.Presentation.ViewModels"
             x:Class="Stelliberty.Desktop.Views.Dialogs.AccentColorPickerView"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel">
  <UserControl.Resources>
    <ControlTheme x:Key="AccentComponentSliderTheme" TargetType="Slider">
      <Setter Property="Height" Value="32" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Background="Transparent">
            <Border Height="12" Margin="8,0" CornerRadius="6"
                    Background="{TemplateBinding Background}" />
            <primitives:Track x:Name="PART_Track"
                              Minimum="{TemplateBinding Minimum}"
                              Maximum="{TemplateBinding Maximum}"
                              Value="{TemplateBinding Value, Mode=TwoWay}"
                              Orientation="Horizontal">
              <primitives:Track.Thumb>
                <primitives:Thumb Width="16" Height="24">
                  <primitives:Thumb.Template>
                    <ControlTemplate>
                      <Border Background="White" BorderBrush="#66000000"
                              BorderThickness="2" CornerRadius="8" />
                    </ControlTemplate>
                  </primitives:Thumb.Template>
                </primitives:Thumb>
              </primitives:Track.Thumb>
            </primitives:Track>
          </Grid>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </UserControl.Resources>
  <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="18" Width="520">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <TextBlock Classes="dialog-title"
                 Text="{Binding Theme.AccentColorSectionTitle}"
                 VerticalAlignment="Center" />
      <Button Grid.Column="1"
              Classes="dialog-close"
              AutomationProperties.AutomationId="Settings.AccentColorDialog.CloseButton"
              Click="OnCancelClick">
        <iconPacks:PackIconMingCuteIcons Width="16" Height="16" Kind="CloseFill" />
      </Button>
    </Grid>

    <StackPanel Grid.Row="1" Spacing="6">
      <TextBlock Text="{Binding Theme.AccentHueText}" />
      <Slider x:Name="PART_HueSlider"
              Theme="{StaticResource AccentComponentSliderTheme}"
              AutomationProperties.AutomationId="Settings.AccentColorDialog.HueSlider"
              AutomationProperties.Name="{Binding Theme.AccentHueText}"
              Minimum="0" Maximum="360" SmallChange="1" LargeChange="15" />
      <TextBlock Text="{Binding Theme.AccentChromaText}" />
      <Slider x:Name="PART_ChromaSlider"
              Theme="{StaticResource AccentComponentSliderTheme}"
              AutomationProperties.AutomationId="Settings.AccentColorDialog.ChromaSlider"
              AutomationProperties.Name="{Binding Theme.AccentChromaText}"
              Minimum="0" Maximum="0.5" Value="0.1" SmallChange="0.001" LargeChange="0.01" />
    </StackPanel>

    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">
      <Border x:Name="PART_LightPreview" Padding="16" CornerRadius="16">
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding Theme.LightThemeText}" Foreground="#212121" />
          <Border x:Name="PART_LightAccent" Padding="12" CornerRadius="10">
            <TextBlock x:Name="PART_LightOnAccent" Text="{Binding Theme.AccentColorSectionTitle}" />
          </Border>
          <Border x:Name="PART_LightSelected" Padding="12" CornerRadius="10" BorderThickness="1">
            <TextBlock x:Name="PART_LightSelectedText" Text="{Binding Theme.AccentSelectedPreviewText}" />
          </Border>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" x:Name="PART_DarkPreview" Padding="16" CornerRadius="16">
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding Theme.DarkThemeText}" Foreground="#EFEFEF" />
          <Border x:Name="PART_DarkAccent" Padding="12" CornerRadius="10">
            <TextBlock x:Name="PART_DarkOnAccent" Text="{Binding Theme.AccentColorSectionTitle}" />
          </Border>
          <Border x:Name="PART_DarkSelected" Padding="12" CornerRadius="10" BorderThickness="1">
            <TextBlock x:Name="PART_DarkSelectedText" Text="{Binding Theme.AccentSelectedPreviewText}" />
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <StackPanel Grid.Row="3"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="10">
      <Button Classes="dialog-secondary"
              AutomationProperties.AutomationId="Settings.AccentColorDialog.CancelButton"
              Content="{Binding DialogCancelText}"
              Click="OnCancelClick" />
      <Button Classes="dialog-primary"
              AutomationProperties.AutomationId="Settings.AccentColorDialog.ConfirmButton"
              Content="{Binding DialogConfirmText}"
              Click="OnConfirmClick" />
    </StackPanel>
  </Grid>
</UserControl>
