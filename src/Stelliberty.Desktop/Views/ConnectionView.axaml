<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Stelliberty.Desktop.Controls"
             xmlns:loc="using:Stelliberty.Desktop.Localization"
             xmlns:vm="using:Stelliberty.Presentation.ViewModels"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             x:Class="Stelliberty.Desktop.Views.ConnectionView"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel"
             controls:InputDefocusBehavior.IsEnabled="True"
             Background="Transparent">
  <UserControl.Styles>
    <Style Selector="Grid.connection-card-stats">
      <Setter Property="Grid.Row" Value="2" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
    <Style Selector="Border.connection-card.list-layout Grid.connection-card-header">
      <Setter Property="Grid.ColumnSpan" Value="2" />
    </Style>
    <Style Selector="Border.connection-card.list-layout Grid.connection-card-stats">
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
  </UserControl.Styles>
  <Grid x:Name="ConnectionPageRoot"
        RowDefinitions="Auto,*" RowSpacing="16"
        DataContext="{Binding ConnectionPage}"
        x:DataType="vm:ConnectionPageViewModel">

      <Border Classes="surface-header"
            Margin="0,6,9,0"
            AutomationProperties.AutomationId="Connections.Toolbar">
      <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
          <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Classes="signal-dot" />
              <TextBlock Classes="list-eyebrow" Text="{loc:Loc Connections.Header.Eyebrow}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="7">
              <TextBlock Classes="list-count"
                         Text="{Binding FilteredConnectionCount}" />
              <TextBlock Classes="list-count-unit" Text="{loc:Loc Connections.Count.Unit}" />
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Column="1"
                      Orientation="Horizontal" Spacing="8"
                      VerticalAlignment="Center">
            <Border Classes="list-stat">
              <StackPanel Spacing="3">
                <TextBlock Classes="list-stat-label" Text="{loc:Loc Connections.Stat.Direct}" />
                <TextBlock Classes="list-stat-value" Text="{Binding DirectConnectionCount}" />
              </StackPanel>
            </Border>
            <Border Classes="list-stat">
              <StackPanel Spacing="3">
                <TextBlock Classes="list-stat-label" Text="{loc:Loc Connections.Stat.Proxy}" />
                <TextBlock Classes="list-stat-value" Text="{Binding ProxyConnectionCount}" />
              </StackPanel>
            </Border>
            <Border Classes="list-stat" MinWidth="112">
              <StackPanel Spacing="3">
                <TextBlock Classes="list-stat-label" Text="{loc:Loc Common.Upload}" />
                <TextBlock Classes="list-stat-value small"
                           AutomationProperties.AutomationId="Connections.TotalUploadSpeedText"
                           Text="{Binding TotalUploadSpeedText}" />
              </StackPanel>
            </Border>
            <Border Classes="list-stat" MinWidth="112">
              <StackPanel Spacing="3">
                <TextBlock Classes="list-stat-label" Text="{loc:Loc Common.Download}" />
                <TextBlock Classes="list-stat-value small"
                           AutomationProperties.AutomationId="Connections.TotalDownloadSpeedText"
                           Text="{Binding TotalDownloadSpeedText}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Classes="list-chip"
                    Classes.selected="{Binding IsAllConnectionsSelected}"
                    AutomationProperties.AutomationId="Connections.Filter.AllButton"
                    Command="{Binding ShowAllConnectionsCommand}"
                    Content="{loc:Loc Common.Filter.All}" />
            <Button Classes="list-chip"
                    Classes.selected="{Binding IsActiveConnectionsSelected}"
                    AutomationProperties.AutomationId="Connections.Filter.ActiveButton"
                    Command="{Binding ShowActiveConnectionsCommand}"
                    Content="{loc:Loc Connections.Filter.Active}" />
            <Button Classes="list-chip"
                    Classes.selected="{Binding IsDisconnectedConnectionsSelected}"
                    AutomationProperties.AutomationId="Connections.Filter.DisconnectedButton"
                    Command="{Binding ShowDisconnectedConnectionsCommand}"
                    Content="{loc:Loc Connections.Filter.Disconnected}" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
            <Button Classes="toolbar-icon"
                    AutomationProperties.AutomationId="Connections.RefreshButton"
                    Command="{Binding RefreshConnectionsCommand}"
                    ToolTip.Tip="{loc:Loc Connections.Action.Refresh}">
              <iconPacks:PackIconMingCuteIcons Classes="icon" Width="15" Height="15" Kind="Refresh1Line" />
            </Button>
            <Button Classes="toolbar-icon"
                    AutomationProperties.AutomationId="Connections.TogglePauseButton"
                    Command="{Binding TogglePauseCommand}"
                    ToolTip.Tip="{Binding MonitoringToggleTooltip}">
              <iconPacks:PackIconMingCuteIcons Classes="icon pause-toggle-icon"
                                                Classes.paused="{Binding IsMonitoringPaused}"
                                                Width="15" Height="15" />
            </Button>
            <Button Classes="toolbar-icon"
                    AutomationProperties.AutomationId="Connections.CloseAllButton"
                    Command="{Binding CloseAllConnectionsCommand}"
                    ToolTip.Tip="{loc:Loc Connections.Action.CloseAll}">
              <iconPacks:PackIconMingCuteIcons Classes="icon" Width="15" Height="15" Kind="CloseLine" />
            </Button>
            <Button Classes="toolbar-icon"
                    AutomationProperties.AutomationId="Connections.ToggleLayoutButton"
                    Command="{Binding ToggleLayoutCommand}"
                    ToolTip.Tip="{Binding LayoutToggleTooltip}">
              <iconPacks:PackIconMingCuteIcons Classes="icon" Width="15" Height="15" Kind="{Binding LayoutToggleIcon}" />
            </Button>
          </StackPanel>
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <TextBox
                   Classes="list-search"
                   AutomationProperties.AutomationId="Connections.SearchBox"
                   PlaceholderText="{loc:Loc Connections.Search.Placeholder}"
                   Text="{Binding SearchKeyword, Mode=TwoWay}"
                   HorizontalAlignment="Stretch">
            <TextBox.InnerLeftContent>
              <Border Padding="10,0,4,0">
                <iconPacks:PackIconMingCuteIcons Width="14" Height="14"
                                                   Kind="SearchLine"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
              </Border>
            </TextBox.InnerLeftContent>
          </TextBox>
          <controls:CardMenuButton Grid.Column="1"
                                   Classes="toolbar-icon"
                                   Classes.filter-active="{Binding IsRouteFilterActive}"
                                   VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="Connections.RouteFilterButton"
                                   ShowItemIcons="False"
                                   ItemsSource="{Binding RouteFilterOptions}"
                                   ItemCommand="{Binding SelectRouteFilterCommand}"
                                   ToolTip.Tip="{Binding RouteFilterTooltip}">
            <iconPacks:PackIconMingCuteIcons Classes="icon" Width="15" Height="15" Kind="FilterLine" />
          </controls:CardMenuButton>
          <controls:CardMenuButton Grid.Column="2"
                                   Classes="toolbar-icon"
                                   Classes.filter-active="{Binding IsSortActive}"
                                   VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="Connections.SortMenuButton"
                                   ToolTip.Tip="{Binding SortMenuTooltip}">
            <iconPacks:PackIconMingCuteIcons Classes="icon" Width="15" Height="15" Kind="ListOrderedLine" />
            <controls:CardMenuButton.MenuContent>
              <ScrollViewer MaxHeight="440" HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                <StackPanel MinWidth="180" Spacing="4">
                  <ItemsControl ItemsSource="{Binding SortMenuOptions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ConnectionSortMenuItemViewModel">
                        <Button Classes="card-menu-row"
                                Classes.selected="{Binding IsSelected}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Command="{Binding SelectCommand}"
                                CommandParameter="{Binding}"
                                Content="{Binding DisplayName}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border Height="1" Margin="6,4" Background="{DynamicResource AppBorderBrush}" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                    <Button Classes="card-menu-row"
                            Classes.selected="{Binding IsSortAscending}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            AutomationProperties.AutomationId="Connections.SortAscendingButton"
                            Command="{Binding SortAscendingCommand}"
                            Content="{loc:Loc Connections.Sort.Ascending}" />
                    <Button Grid.Column="1" Classes="card-menu-row"
                            Classes.selected="{Binding IsSortDescending}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            AutomationProperties.AutomationId="Connections.SortDescendingButton"
                            Command="{Binding SortDescendingCommand}"
                            Content="{loc:Loc Connections.Sort.Descending}" />
                  </Grid>
                </StackPanel>
              </ScrollViewer>
            </controls:CardMenuButton.MenuContent>
          </controls:CardMenuButton>
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Border Classes="list-empty"
              IsVisible="{Binding IsEmptyVisible}">
        <StackPanel Spacing="18" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Panel HorizontalAlignment="Center">
            <Border Classes="list-empty-halo" />
            <iconPacks:PackIconMingCuteIcons Classes="list-empty-icon" Kind="TransferHorizontalLine" />
          </Panel>
          <StackPanel Spacing="7">
            <TextBlock Classes="list-empty-text" AutomationProperties.AutomationId="Connections.EmptyText" Text="{Binding EmptyText}" />
            <TextBlock Classes="list-empty-hint" Text="{loc:Loc Connections.Empty.Hint}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <ScrollViewer AutomationProperties.AutomationId="Connections.ListScroll"
                    IsVisible="{Binding !IsEmptyVisible}"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl AutomationProperties.AutomationId="Connections.List"
                      Margin="0,0,9,15"
                      ItemsSource="{Binding FilteredConnectionRows}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <controls:VirtualizingWrapPanel MinItemWidth="344"
                                            ItemHeight="{Binding CardItemHeight}"
                                            SingleColumn="{Binding IsListLayout}"
                                            ColumnSpacing="12" RowSpacing="12" EdgePadding="0" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ConnectionRowViewModel">
              <Border Classes="surface-card connection-card"
                      Classes.list-layout="{Binding #ConnectionPageRoot.((vm:ConnectionPageViewModel)DataContext).IsListLayout}">
                <Grid>
                  <Button Classes="card-hit-area"
                          AutomationProperties.AutomationId="{Binding RowAutomationId}"
                          Command="{Binding #ConnectionPageRoot.((vm:ConnectionPageViewModel)DataContext).ShowDetailCommand}"
                          CommandParameter="{Binding Id}" />

                  <controls:ConnectionCardGrid Margin="16"
                                               IsListLayout="{Binding #ConnectionPageRoot.((vm:ConnectionPageViewModel)DataContext).IsListLayout}">
                    <Grid Classes="connection-card-header" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                      <Border Classes="list-pill" Tag="{Binding NetworkPillTag}" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock AutomationProperties.AutomationId="{Binding NetworkAutomationId}"
                                   Text="{Binding NetworkLabel}" />
                      </Border>
                      <TextBlock Grid.Column="1"
                                 IsHitTestVisible="False"
                                 Text="{Binding DisplayAddress}"
                                 Foreground="{DynamicResource AppTextPrimaryBrush}"
                                 FontWeight="Normal"
                                 FontSize="14"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" />
                      <Button Grid.Column="2" Classes="toolbar-icon"
                              Width="28" Height="28" MinWidth="28" MinHeight="28"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              IsVisible="{Binding IsActive}"
                              AutomationProperties.AutomationId="{Binding CloseAutomationId}"
                              Command="{Binding #ConnectionPageRoot.((vm:ConnectionPageViewModel)DataContext).CloseConnectionCommand}"
                              CommandParameter="{Binding Id}">
                        <iconPacks:PackIconMingCuteIcons Classes="icon" Width="12" Height="12" Kind="CloseLine" />
                      </Button>
                    </Grid>

                    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="5" VerticalAlignment="Top" IsHitTestVisible="False">
                      <Grid ColumnDefinitions="72,*" ColumnSpacing="8"
                            IsVisible="{Binding IsProcessVisible}">
                        <TextBlock Text="{loc:Loc Connections.Card.Process}"
                                   Classes="metric-label"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Process}"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis" />
                      </Grid>
                      <Grid Grid.Row="1" ColumnDefinitions="72,*" ColumnSpacing="8">
                        <TextBlock Text="{loc:Loc Connections.Card.Rule}"
                                   Classes="metric-label"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Rule}"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis" />
                      </Grid>
                      <Grid Grid.Row="2" ColumnDefinitions="72,*" ColumnSpacing="8">
                        <TextBlock Text="{loc:Loc Connections.Card.Chain}"
                                   Classes="metric-label"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   AutomationProperties.AutomationId="{Binding ChainAutomationId}"
                                   Text="{Binding ChainSummaryText}"
                                   Foreground="{DynamicResource AppAccentBrush}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis" />
                      </Grid>
                      <Grid Grid.Row="3" ColumnDefinitions="72,*" ColumnSpacing="8">
                        <TextBlock Text="{loc:Loc Connections.Detail.Speed}"
                                   Classes="metric-label"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SpeedText}"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </Grid>

                    <Grid Classes="connection-card-stats" ColumnDefinitions="*,*,*" ColumnSpacing="8" IsHitTestVisible="False">
                      <Border Classes="list-mini-stat" VerticalAlignment="Bottom">
                        <StackPanel Spacing="2">
                          <TextBlock Classes="metric-label" Text="{loc:Loc Connections.Card.UploadAmount}" />
                          <TextBlock Text="{Binding UploadAmountText}"
                                     Foreground="{DynamicResource AppTextPrimaryBrush}"
                                     FontSize="12"
                                     FontWeight="Normal"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="1" Classes="list-mini-stat" VerticalAlignment="Bottom">
                        <StackPanel Spacing="2">
                          <TextBlock Classes="metric-label" Text="{loc:Loc Connections.Card.DownloadAmount}" />
                          <TextBlock Text="{Binding DownloadAmountText}"
                                     Foreground="{DynamicResource AppTextPrimaryBrush}"
                                     FontSize="12"
                                     FontWeight="Normal"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="2" Classes="list-mini-stat" VerticalAlignment="Bottom">
                        <StackPanel Spacing="2">
                          <TextBlock Classes="metric-label" Text="{loc:Loc Connections.Card.Duration}" />
                          <TextBlock AutomationProperties.AutomationId="{Binding DurationAutomationId}"
                                     Text="{Binding DurationText}"
                                     Foreground="{DynamicResource AppTextPrimaryBrush}"
                                     FontSize="12"
                                     FontWeight="Normal" />
                        </StackPanel>
                      </Border>
                    </Grid>
                  </controls:ConnectionCardGrid>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <controls:OverlayDialogHost AutomationProperties.AutomationId="Connections.DialogOverlay"
                                  IsOpen="{Binding IsDetailVisible}">
        <controls:OverlayDialogHost.DialogContent>
          <controls:DialogPanel PanelWidth="520"
                                ContentPadding="0,0,2,0"
                                AutomationProperties.AutomationId="Connections.DetailPanel"
                                IsOpen="{Binding IsDetailVisible}">
            <controls:DialogPanel.DialogContent>
              <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="24,24,24,0">
                  <TextBlock Classes="dialog-title"
                             Text="{loc:Loc Connections.Detail.Title}"
                             VerticalAlignment="Center" />
                  <Button Grid.Column="1"
                          Classes="dialog-close"
                          AutomationProperties.AutomationId="Connections.Detail.CloseButton"
                          Command="{Binding CloseDetailCommand}">
                    <iconPacks:PackIconMingCuteIcons Width="16" Height="16" Kind="CloseFill" />
                  </Button>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              AutomationProperties.AutomationId="Connections.Detail.ScrollViewer"
                              MaxHeight="560"
                              VerticalScrollBarVisibility="Auto">
                  <StackPanel Spacing="12" Margin="24,0,22,0">
                    <Border Classes="dialog-section">
                      <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <iconPacks:PackIconMingCuteIcons Width="16" Height="16" Kind="RouteLine"
                                                           Foreground="{DynamicResource AppAccentBrush}"
                                                           VerticalAlignment="Center" />
                          <TextBlock Classes="dialog-section-title" Text="{loc:Loc Connections.Card.Chain}" />
                        </StackPanel>
                        <SelectableTextBlock FontSize="16" FontWeight="Normal"
                                   Foreground="{DynamicResource AppAccentBrush}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="Connections.Detail.SummaryChain"
                                   Text="{Binding DetailSummaryChain}" />
                        <Border Background="{DynamicResource AppInputBrush}" CornerRadius="10" Padding="12,8">
                          <StackPanel Spacing="3">
                            <TextBlock Classes="dialog-label" Text="{loc:Loc Connections.Card.Rule}" />
                            <SelectableTextBlock Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       Text="{Binding DetailSummaryRule}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="Connections.Detail.SummaryRule" />
                          </StackPanel>
                        </Border>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                          <StackPanel Spacing="2">
                            <TextBlock Classes="dialog-label" Text="{loc:Loc Common.Upload}" />
                            <SelectableTextBlock FontWeight="Normal"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       AutomationProperties.AutomationId="Connections.Detail.SummaryUpload"
                                       Text="{Binding DetailSummaryUpload}" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Classes="dialog-label" Text="{loc:Loc Common.Download}" />
                            <SelectableTextBlock FontWeight="Normal"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       AutomationProperties.AutomationId="Connections.Detail.SummaryDownload"
                                       Text="{Binding DetailSummaryDownload}" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Classes="dialog-label" Text="{loc:Loc Connections.Card.Duration}" />
                            <SelectableTextBlock FontWeight="Normal"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       AutomationProperties.AutomationId="Connections.Detail.SummaryDuration"
                                       Text="{Binding DetailSummaryDuration}" />
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </Border>

                    <ItemsControl AutomationProperties.AutomationId="Connections.Detail.Groups"
                                  ItemsSource="{Binding SelectedConnectionDetailGroups}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Spacing="10" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ConnectionDetailGroupViewModel">
                          <Border Classes="dialog-section">
                            <StackPanel Spacing="8">
                              <TextBlock Classes="dialog-section-title" Text="{Binding Title}" />
                              <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:ConnectionDetailRowViewModel">
                                    <Border Classes="connection-detail-row dense">
                                      <Grid ColumnDefinitions="104,*,Auto" ColumnSpacing="12">
                                        <TextBlock Classes="dialog-label" Text="{Binding Label}"
                                                   VerticalAlignment="Center" />
                                        <SelectableTextBlock Grid.Column="1"
                                                   Classes="connection-detail-value"
                                                   VerticalAlignment="Center"
                                                   Tag="{Binding Emphasis}"
                                                   Text="{Binding Value}" />
                                        <Button Grid.Column="2"
                                                Classes="toolbar-icon"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding CanCopy}"
                                                CommandParameter="{Binding Value}"
                                                Click="OnCopyValueClicked"
                                                ToolTip.Tip="{loc:Loc Common.Copy}">
                                          <iconPacks:PackIconMingCuteIcons Classes="icon" Width="14" Height="14" Kind="Copy2Line" />
                                        </Button>
                                      </Grid>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="24,4,24,24">
                  <Button Classes="dialog-secondary"
                          AutomationProperties.AutomationId="Connections.Detail.CloseFooterButton"
                          Command="{Binding CloseDetailCommand}"
                          Content="{loc:Loc Common.Close}" />
                </StackPanel>
              </Grid>
            </controls:DialogPanel.DialogContent>
          </controls:DialogPanel>
        </controls:OverlayDialogHost.DialogContent>
      </controls:OverlayDialogHost>
    </Grid>
  </Grid>
</UserControl>
