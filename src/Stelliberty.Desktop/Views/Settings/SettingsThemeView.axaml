<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Stelliberty.Desktop.Controls"
             xmlns:conv="using:Stelliberty.Desktop.Converters"
             xmlns:loc="using:Stelliberty.Desktop.Localization"
             xmlns:vm="using:Stelliberty.Presentation.ViewModels"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             x:Class="Stelliberty.Desktop.Views.Settings.SettingsThemeView"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel">
  <UserControl.Resources>
    <conv:HexToBrushConverter x:Key="HexToBrush" />
  </UserControl.Resources>

<!-- 主题外观 -->
<StackPanel Spacing="10" IsVisible="{Binding Settings.IsThemeVisible}">
  <StackPanel Spacing="0">
    <TextBlock Classes="surface-group-title" Text="{Binding Settings.GroupAppearanceText}" />
    <Border Classes="surface-group">
      <StackPanel>
        <Border Classes="settings-inline-row">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="settings-row-title"
                       VerticalAlignment="Center"
                       Text="{Binding Theme.FieldLabelText}" />
            <ComboBox Grid.Column="1"
                      AutomationProperties.AutomationId="Settings.ThemeComboBox"
                      MinWidth="160"
                      ItemsSource="{Binding Theme.Options}"
                      SelectedItem="{Binding Theme.SelectedOption, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ISelectionOption">
                  <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
        </Border>
        <Border Classes="settings-row-divider" />
        <Border Classes="settings-inline-row">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <TextBlock Grid.Column="0" Classes="settings-row-title"
                       VerticalAlignment="Center"
                       Text="{Binding Theme.AccentColorSectionTitle}" />
            <Button Grid.Column="1" Classes="accent-swatch"
                    AutomationProperties.AutomationId="Settings.EditCustomAccentButton"
                    IsVisible="{Binding Theme.IsCustomAccentMode}"
                    Command="{Binding Theme.EditCustomAccentColorCommand}"
                    Background="{Binding Theme.CustomAccentColor, Converter={StaticResource HexToBrush}}" />
            <ComboBox Grid.Column="2"
                      AutomationProperties.AutomationId="Settings.AccentModeComboBox"
                      MinWidth="160"
                      ItemsSource="{Binding Theme.AccentModeOptions}"
                      SelectedItem="{Binding Theme.SelectedAccentModeOption, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ISelectionOption">
                  <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
        </Border>
        <Border Classes="settings-row-divider"
                IsVisible="{Binding Theme.IsWindowEffectSupported}" />
        <Border Classes="settings-inline-row"
                IsVisible="{Binding Theme.IsWindowEffectSupported}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="settings-row-title"
                       VerticalAlignment="Center"
                       Text="{Binding Theme.WindowEffectSectionTitle}" />
            <ComboBox Grid.Column="1"
                      AutomationProperties.AutomationId="Settings.WindowEffectComboBox"
                      MinWidth="160"
                      ItemsSource="{Binding Theme.WindowEffectOptions}"
                      SelectedItem="{Binding Theme.SelectedWindowEffectOption, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ISelectionOption">
                  <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
        </Border>
        <Border Classes="settings-row-divider" />
        <Border Classes="settings-inline-row">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="settings-row-title"
                       VerticalAlignment="Center"
                       Text="{Binding Theme.SidebarDividerText}" />
            <ToggleSwitch Grid.Column="1"
                          AutomationProperties.AutomationId="Settings.SidebarDividerToggle"
                          IsChecked="{Binding Theme.IsSidebarDividerVisible, Mode=TwoWay}" />
          </Grid>
        </Border>
      </StackPanel>
    </Border>
  </StackPanel>
  <StackPanel Spacing="0">
    <TextBlock Classes="surface-group-title" Text="{Binding Theme.BackgroundImageSectionTitle}" />
    <Border Classes="surface-group">
      <StackPanel>
        <Border Classes="settings-inline-row">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <StackPanel Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="{Binding Theme.BackgroundImagePathText}" TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding Theme.BackgroundImagePathText}" />
              <TextBlock Text="{Binding Theme.BackgroundImageErrorText}" TextWrapping="Wrap"
                         Foreground="{DynamicResource AppDangerBrush}"
                         IsVisible="{Binding Theme.BackgroundImageLoadFailed}" />
            </StackPanel>
            <Button Grid.Column="1" Content="{Binding Theme.BackgroundImageChooseText}"
                    AutomationProperties.AutomationId="Settings.BackgroundImage.Choose"
                    Click="OnChooseBackgroundImageClicked" />
            <Button Grid.Column="2" Content="{Binding Theme.BackgroundImageClearText}"
                    AutomationProperties.AutomationId="Settings.BackgroundImage.Clear"
                    IsEnabled="{Binding Theme.HasBackgroundImage}"
                    Command="{Binding Theme.ClearBackgroundImageCommand}" />
          </Grid>
        </Border>
        <Border Classes="settings-row-divider" />
        <Border Classes="settings-inline-row">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="settings-row-title" VerticalAlignment="Center"
                       Text="{Binding Theme.BackgroundImageStretchText}" />
            <ComboBox Grid.Column="1" MinWidth="160"
                      AutomationProperties.AutomationId="Settings.BackgroundImage.Stretch"
                      ItemsSource="{Binding Theme.BackgroundStretchOptions}"
                      SelectedItem="{Binding Theme.SelectedBackgroundStretchOption, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ISelectionOption">
                  <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
        </Border>
        <Border Classes="settings-row-divider" />
        <Border Classes="settings-inline-row">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="settings-row-title" VerticalAlignment="Center"
                       Text="{Binding Theme.BackgroundImageHorizontalText}" />
            <ComboBox Grid.Column="1" MinWidth="160"
                      AutomationProperties.AutomationId="Settings.BackgroundImage.Horizontal"
                      ItemsSource="{Binding Theme.BackgroundHorizontalOptions}"
                      SelectedItem="{Binding Theme.SelectedBackgroundHorizontalOption, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ISelectionOption">
                  <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
        </Border>
        <Border Classes="settings-row-divider" />
        <Border Classes="settings-inline-row">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="settings-row-title" VerticalAlignment="Center"
                       Text="{Binding Theme.BackgroundImageVerticalText}" />
            <ComboBox Grid.Column="1" MinWidth="160"
                      AutomationProperties.AutomationId="Settings.BackgroundImage.Vertical"
                      ItemsSource="{Binding Theme.BackgroundVerticalOptions}"
                      SelectedItem="{Binding Theme.SelectedBackgroundVerticalOption, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ISelectionOption">
                  <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
        </Border>
        <Border Classes="settings-row-divider" />
        <Border Classes="settings-inline-row">
          <Grid ColumnDefinitions="*,200,48" ColumnSpacing="10">
            <StackPanel Spacing="4" VerticalAlignment="Center">
              <TextBlock Classes="settings-row-title" Text="{Binding Theme.BackgroundImageTransparencyText}" />
              <TextBlock Text="{Binding Theme.BackgroundImageTransparencyHint}" TextWrapping="Wrap"
                         Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="12" />
            </StackPanel>
            <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="Settings.BackgroundImage.Transparency"
                    Value="{Binding Theme.BackgroundImageTransparency, Mode=TwoWay}" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                       Text="{Binding Theme.BackgroundImageTransparency, StringFormat='{}{0}%'}" />
          </Grid>
        </Border>
      </StackPanel>
    </Border>
  </StackPanel>
</StackPanel>
</UserControl>
