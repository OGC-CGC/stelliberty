<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Stelliberty.Desktop.Controls"
             xmlns:loc="using:Stelliberty.Desktop.Localization"
             xmlns:vm="using:Stelliberty.Presentation.ViewModels"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             x:Class="Stelliberty.Desktop.Views.Settings.SettingsRootView"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel">
<!-- 设置首页：分组入口列表 -->
<StackPanel Spacing="10" IsVisible="{Binding Settings.IsRootVisible}">
  <StackPanel Spacing="0">
    <TextBlock Classes="surface-group-title" Text="{Binding Settings.GroupPersonalizationText}" />
    <Border Classes="surface-group">
      <StackPanel>
        <Button Classes="settings-row first"
                AutomationProperties.AutomationId="Settings.ThemeEntry"
                Command="{Binding Settings.ShowThemeCommand}">
          <Grid ColumnDefinitions="40,*,Auto">
            <Border Grid.Column="0" Classes="settings-icon-badge">
              <iconPacks:PackIconMingCuteIcons Classes="settings-entry-icon settings-theme-icon"
                                                Kind="Palette3Line" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center" Margin="10,0,0,0">
              <TextBlock Classes="settings-row-title" Text="{Binding Settings.ThemeEntryTitle}" />
              <TextBlock Classes="settings-row-subtitle" Text="{Binding Settings.ThemeEntryDescription}" />
            </StackPanel>
            <iconPacks:PackIconMingCuteIcons Grid.Column="2"
                                              Classes="settings-chevron"
                                              Kind="RightSmallLine" />
          </Grid>
        </Button>
        <Button Classes="settings-row last"
                AutomationProperties.AutomationId="Settings.LanguageEntry"
                Command="{Binding Settings.ShowLanguageCommand}">
          <Grid ColumnDefinitions="40,*,Auto">
            <Border Grid.Column="0" Classes="settings-icon-badge">
              <iconPacks:PackIconMingCuteIcons Classes="settings-entry-icon"
                                                Kind="Translate2Line" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center" Margin="10,0,0,0">
              <TextBlock Classes="settings-row-title" Text="{Binding Settings.LanguageEntryTitle}" />
              <TextBlock Classes="settings-row-subtitle" Text="{Binding Settings.LanguageEntryDescription}" />
            </StackPanel>
            <iconPacks:PackIconMingCuteIcons Grid.Column="2"
                                              Classes="settings-chevron"
                                              Kind="RightSmallLine" />
          </Grid>
        </Button>
      </StackPanel>
    </Border>
  </StackPanel>

  <StackPanel Spacing="0">
    <TextBlock Classes="surface-group-title" Text="{Binding Settings.GroupClashText}" />
    <Border Classes="surface-group">
      <StackPanel>
        <Button Classes="settings-row first"
                AutomationProperties.AutomationId="Settings.NetworkEntry"
                Command="{Binding Settings.ShowNetworkCommand}">
          <Grid ColumnDefinitions="40,*,Auto">
            <Border Grid.Column="0" Classes="settings-icon-badge">
              <iconPacks:PackIconMingCuteIcons Classes="settings-entry-icon"
                                                Kind="RouteLine" />
            </Border>
            <TextBlock Grid.Column="1" Classes="settings-row-title" VerticalAlignment="Center" Margin="10,0,0,0" Text="{Binding Settings.ClashNetworkText}" />
            <iconPacks:PackIconMingCuteIcons Grid.Column="2" Classes="settings-chevron" Kind="RightSmallLine" />
          </Grid>
        </Button>
        <Button Classes="settings-row"
                AutomationProperties.AutomationId="Settings.PortControlEntry"
                Command="{Binding Settings.ShowPortControlCommand}">
          <Grid ColumnDefinitions="40,*,Auto">
            <Border Grid.Column="0" Classes="settings-icon-badge">
              <iconPacks:PackIconMingCuteIcons Classes="settings-entry-icon"
                                                Kind="Settings6Line" />
            </Border>
            <TextBlock Grid.Column="1" Classes="settings-row-title" VerticalAlignment="Center" Margin="10,0,0,0" Text="{Binding Settings.ClashPortControlText}" />
            <iconPacks:PackIconMingCuteIcons Grid.Column="2" Classes="settings-chevron" Kind="RightSmallLine" />
          </Grid>
        </Button>
        <Button Classes="settings-row"
                AutomationProperties.AutomationId="Settings.SystemIntegrationEntry"
                Command="{Binding Settings.ShowSystemIntegrationCommand}">
          <Grid ColumnDefinitions="40,*,Auto">
            <Border Grid.Column="0" Classes="settings-icon-badge">
              <iconPacks:PackIconMingCuteIcons Classes="settings-entry-icon"
                                                Kind="ComputerLine" />
            </Border>
            <TextBlock Grid.Column="1" Classes="settings-row-title" VerticalAlignment="Center" Margin="10,0,0,0" Text="{Binding Settings.ClashSystemIntegrationText}" />
            <iconPacks:PackIconMingCuteIcons Grid.Column="2" Classes="settings-chevron" Kind="RightSmallLine" />
          </Grid>
        </Button>
        <Button Classes="settings-row"
                AutomationProperties.AutomationId="Settings.DnsEntry"
                Command="{Binding Settings.ShowDnsCommand}">
          <Grid ColumnDefinitions="40,*,Auto">
            <Border Grid.Column="0" Classes="settings-icon-badge">
              <iconPacks:PackIconMingCuteIcons Classes="settings-entry-icon"
                                                Kind="EarthLine" />
            </Border>
            <TextBlock Grid.Column="1" Classes="settings-row-title" VerticalAlignment="Center" Margin="10,0,0,0" Text="{Binding Settings.ClashDnsText}" />
            <iconPacks:PackIconMingCuteIcons Grid.Column="2" Classes="settings-chevron" Kind="RightSmallLine" />
          </Grid>
        </Button>
        <Button Classes="settings-row"
                AutomationProperties.AutomationId="Settings.PerformanceEntry"
                Command="{Binding Settings.ShowPerformanceCommand}">
          <Grid ColumnDefinitions="40,*,Auto">
            <Border Grid.Column="0" Classes="settings-icon-badge">
              <iconPacks:PackIconMingCuteIcons Classes="settings-entry-icon"
                                                Kind="PerformanceLine" />
            </Border>
            <TextBlock Grid.Column="1" Classes="settings-row-title" VerticalAlignment="Center" Margin="10,0,0,0" Text="{Binding Settings.ClashPerformanceText}" />
            <iconPacks:PackIconMingCuteIcons Grid.Column="2" Classes="settings-chevron" Kind="RightSmallLine" />
          </Grid>
        </Button>
        <Button Classes="settings-row last"
                AutomationProperties.AutomationId="Settings.CoreLogEntry"
                Command="{Binding Settings.ShowCoreLogCommand}">
          <Grid ColumnDefinitions="40,*,Auto">
            <Border Grid.Column="0" Classes="settings-icon-badge">
              <iconPacks:PackIconMingCuteIcons Classes="settings-entry-icon"
                                                Kind="TerminalBoxLine" />
            </Border>
            <TextBlock Grid.Column="1" Classes="settings-row-title" VerticalAlignment="Center" Margin="10,0,0,0" Text="{Binding Settings.ClashCoreLogText}" />
            <iconPacks:PackIconMingCuteIcons Grid.Column="2" Classes="settings-chevron" Kind="RightSmallLine" />
          </Grid>
        </Button>
      </StackPanel>
    </Border>
  </StackPanel>

  <StackPanel Spacing="0">
    <TextBlock Classes="surface-group-title" Text="{Binding Settings.GroupApplicationText}" />
    <Border Classes="surface-group">
      <StackPanel>
        <Button Classes="settings-row first"
                AutomationProperties.AutomationId="Settings.AppBehaviorEntry"
                Command="{Binding Settings.ShowAppBehaviorCommand}">
          <Grid ColumnDefinitions="40,*,Auto">
            <Border Grid.Column="0" Classes="settings-icon-badge">
              <iconPacks:PackIconMingCuteIcons Classes="settings-entry-icon"
                                                Kind="ToggleLeftLine" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center" Margin="10,0,0,0">
              <TextBlock Classes="settings-row-title" Text="{Binding Settings.AppBehaviorEntryTitle}" />
              <TextBlock Classes="settings-row-subtitle" Text="{Binding Settings.AppBehaviorEntryDescription}" />
            </StackPanel>
            <iconPacks:PackIconMingCuteIcons Grid.Column="2"
                                              Classes="settings-chevron"
                                              Kind="RightSmallLine" />
          </Grid>
        </Button>
        <Button Classes="settings-row last"
                AutomationProperties.AutomationId="Settings.AboutEntry"
                Command="{Binding Settings.ShowAboutCommand}">
          <Grid ColumnDefinitions="40,*,Auto">
            <Border Grid.Column="0" Classes="settings-icon-badge">
              <iconPacks:PackIconMingCuteIcons Classes="settings-entry-icon"
                                                Kind="InformationLine" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center" Margin="10,0,0,0">
              <TextBlock Classes="settings-row-title" Text="{Binding Settings.AboutEntryTitle}" />
              <TextBlock Classes="settings-row-subtitle" Text="{Binding Settings.AboutEntryDescription}" />
            </StackPanel>
            <iconPacks:PackIconMingCuteIcons Grid.Column="2"
                                              Classes="settings-chevron"
                                              Kind="RightSmallLine" />
          </Grid>
        </Button>
      </StackPanel>
    </Border>
  </StackPanel>

  <StackPanel Spacing="0">
    <TextBlock Classes="surface-group-title" Text="{Binding Settings.GroupMaintenanceText}" />
    <Border Classes="surface-group">
      <Button Classes="settings-row only"
              AutomationProperties.AutomationId="Settings.DataEntry"
              Command="{Binding Settings.ShowDataManagementCommand}">
        <Grid ColumnDefinitions="40,*,Auto">
          <Border Grid.Column="0" Classes="settings-icon-badge">
            <iconPacks:PackIconMingCuteIcons Classes="settings-entry-icon"
                                              Kind="StorageLine" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center" Margin="10,0,0,0">
            <TextBlock Classes="settings-row-title" Text="{Binding Settings.DataManagementEntryTitle}" />
            <TextBlock Classes="settings-row-subtitle" Text="{Binding Settings.DataManagementEntryDescription}" />
          </StackPanel>
          <iconPacks:PackIconMingCuteIcons Grid.Column="2"
                                            Classes="settings-chevron"
                                            Kind="RightSmallLine" />
        </Grid>
      </Button>
    </Border>
  </StackPanel>
</StackPanel>
</UserControl>
