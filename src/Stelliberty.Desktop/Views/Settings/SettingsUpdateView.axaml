<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Stelliberty.Desktop.Localization"
             xmlns:vm="using:Stelliberty.Presentation.ViewModels"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             x:Class="Stelliberty.Desktop.Views.Settings.SettingsUpdateView"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel">
  <Grid>
<!-- 软件更新 -->
<StackPanel Spacing="14" IsVisible="{Binding Settings.IsUpdateVisible}">
  <StackPanel Spacing="0">
    <TextBlock Classes="surface-group-title" Text="{loc:Loc Settings.Update.Section.Check}" />
    <Border Classes="surface-group">
      <StackPanel>
        <Border Classes="settings-inline-row">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Classes="settings-row-title"
                       Text="{Binding Update.ManualText}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Classes="soft-action primary"
                    AutomationProperties.AutomationId="Settings.CheckForUpdatesButton"
                    Command="{Binding Update.CheckCommand}"
                    IsEnabled="{Binding !Update.IsChecking}"
                    VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <iconPacks:PackIconMingCuteIcons Classes="button-spinner" IsVisible="{Binding Update.IsChecking}" Kind="LoadingFill" />
                <TextBlock Text="{loc:Loc Settings.Update.CheckNow}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>
        <Border Classes="settings-row-divider" />
        <Border Classes="settings-inline-row">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Classes="settings-row-title"
                       Text="{Binding Update.AutoCheckText}"
                       VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1"
                          AutomationProperties.AutomationId="Settings.AutoCheckUpdateToggle"
                          IsChecked="{Binding Update.IsAutoCheckEnabled, Mode=TwoWay}" />
          </Grid>
        </Border>
        <Border Classes="settings-row-divider" />
        <Border Classes="settings-inline-row">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Classes="settings-row-title"
                       Text="{Binding Update.FixedIntervalText}"
                       VerticalAlignment="Center" />
            <ComboBox Grid.Column="1"
                      AutomationProperties.AutomationId="Settings.UpdateIntervalComboBox"
                      MinWidth="160"
                      ItemsSource="{Binding Update.CheckIntervalOptions}"
                      SelectedItem="{Binding Update.SelectedCheckIntervalOption, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ISelectionOption">
                  <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
        </Border>
        <Border Classes="settings-row-divider" />
        <Border Classes="settings-inline-row">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="4" VerticalAlignment="Center">
              <TextBlock Classes="settings-row-title" Text="{loc:Loc Settings.Update.Source}" />
              <TextBlock Classes="settings-row-subtitle" Text="{Binding Update.ActiveRepositoryUrl}"
                         ToolTip.Tip="{Binding Update.ActiveRepositoryUrl}" TextTrimming="CharacterEllipsis"
                         MaxWidth="400" HorizontalAlignment="Left" />
            </StackPanel>
            <ComboBox Grid.Column="1" MinWidth="160"
                      AutomationProperties.AutomationId="Settings.UpdateSourceComboBox"
                      IsEnabled="{Binding !Update.IsChecking}"
                      ItemsSource="{Binding Update.UpdateSourceOptions}"
                      SelectedItem="{Binding Update.SelectedUpdateSourceOption, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ISelectionOption">
                  <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
        </Border>
        <Border Classes="settings-row-divider" IsVisible="{Binding Update.IsCustomUpdateSource}" />
        <Border Classes="settings-inline-row" IsVisible="{Binding Update.IsCustomUpdateSource}">
          <StackPanel Spacing="8">
            <TextBlock Classes="settings-row-title" Text="{loc:Loc Settings.Update.Source.RepositoryUrl}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <TextBox Classes="settings-input"
                       AutomationProperties.AutomationId="Settings.CustomUpdateRepositoryTextBox"
                       IsEnabled="{Binding !Update.IsChecking}"
                       Watermark="https://github.com/owner/repository"
                       Text="{Binding Update.CustomRepositoryUrl, Mode=TwoWay}" />
              <Button Grid.Column="1" Classes="soft-action" Content="{loc:Loc Common.Save}"
                      AutomationProperties.AutomationId="Settings.SaveUpdateRepositoryButton"
                      Command="{Binding Update.SaveCustomRepositoryCommand}" />
            </Grid>
            <TextBlock Text="{loc:Loc Settings.Update.Source.InvalidUrl}" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource AppDangerBrush}"
                       IsVisible="{Binding Update.IsCustomRepositoryUrlInvalid}" />
          </StackPanel>
        </Border>
        <Border Classes="settings-row-divider" />
        <Border Classes="settings-inline-row">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Classes="settings-row-title"
                       Text="{Binding Update.ChannelText}"
                       VerticalAlignment="Center" />
            <ComboBox Grid.Column="1"
                      AutomationProperties.AutomationId="Settings.UpdateChannelComboBox"
                      MinWidth="160"
                      ItemsSource="{Binding Update.ChannelOptions}"
                      SelectedItem="{Binding Update.SelectedChannelOption, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ISelectionOption">
                  <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
        </Border>
      </StackPanel>
    </Border>
  </StackPanel>

  <StackPanel Spacing="0">
    <TextBlock Classes="surface-group-title" Text="{loc:Loc Settings.Update.Section.Version}" />
    <Border Classes="surface-group">
      <StackPanel>
        <Border Classes="settings-inline-row">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Classes="settings-row-title" Text="{loc:Loc Settings.Update.CurrentVersion}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="settings-row-subtitle" Text="{Binding Settings.AppVersionText}" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <Border Classes="settings-row-divider" />
        <Border Classes="settings-inline-row">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Classes="settings-row-title" Text="{loc:Loc Settings.Update.Metric.LastCheck}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="settings-row-subtitle" Text="{Binding Update.LastCheckText}" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <Border Classes="settings-row-divider" />
        <Border Classes="settings-inline-row">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Classes="settings-row-title"
                       Text="{loc:Loc Settings.Update.IgnoreCurrent}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Classes="soft-action"
                    AutomationProperties.AutomationId="Settings.IgnoreLatestUpdateVersionButton"
                    Command="{Binding Update.IgnoreLatestVersionCommand}"
                    IsEnabled="{Binding Update.CanIgnoreLatestVersion}"
                    Content="{loc:Loc Settings.Update.Ignore}" />
          </Grid>
        </Border>
      </StackPanel>
    </Border>
  </StackPanel>
</StackPanel>

  </Grid>
</UserControl>
